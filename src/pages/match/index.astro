---
// Match centre. One static page for every match: it reads ?id=<match id> and asks /api/match for the details,
// so new fixtures work without a rebuild. If that is unavailable it falls back to /match/fallback.json (built
// from the stored fixtures: score and scorers only). Live matches refresh every 30 seconds.
import Base from '../../layouts/Base.astro';
---
<Base title="Match centre" description="Timeline, lineups and stats for Indian football matches.">
  <section class="wrap module mc" id="mc" aria-live="polite">
    <a class="mc-back" href="/stats">← Fixtures &amp; results</a>
    <div id="mc-body"><p class="mc-empty">Loading match…</p></div>
    <noscript><p class="mc-empty">Match details need JavaScript.</p></noscript>
  </section>
</Base>

<script>
  import type { Lineup, MatchDetail, MatchEvent, Player, Side } from '../../lib/types';

  type Tab = 'timeline' | 'lineups' | 'stats';
  const root = document.getElementById('mc-body')!;
  const id = new URLSearchParams(location.search).get('id') ?? '';
  let detail: MatchDetail | null = null;
  let basic = false; // true when only the stored score/scorers are available
  let tab: Tab | null = null;
  let timer: number | undefined;

  // ---- tiny DOM helper: text is always set as text, never as HTML ----
  type Child = Node | string | false | null | undefined;
  function h(tag: string, cls?: string | null, ...kids: Child[]): HTMLElement {
    const el = document.createElement(tag);
    if (cls) el.className = cls;
    for (const k of kids) if (k !== false && k != null) el.append(k);
    return el;
  }
  const span = (cls: string | null, text: string) => h('span', cls, text);

  const IST = 'Asia/Kolkata';
  const fmtTime = (iso: string) => new Date(iso).toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit', hour12: false, timeZone: IST });
  const fmtDate = (iso: string) => new Date(iso).toLocaleDateString('en-IN', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric', timeZone: IST });
  const initials = (n: string) => n.replace(/\b(FC|SC|AFC|Football Club|Club)\b/gi, '').trim().split(/\s+/).map((w) => w[0]).join('').slice(0, 3).toUpperCase() || n.slice(0, 3).toUpperCase();

  function crest(t: MatchDetail['home']) {
    const box = h('div', 'mc-crest');
    if (t.logo) {
      const img = document.createElement('img');
      img.src = t.logo; img.alt = ''; img.width = 44; img.height = 44; img.loading = 'lazy'; img.referrerPolicy = 'no-referrer';
      img.onerror = () => { img.remove(); box.textContent = t.short ?? initials(t.name); };
      box.append(img);
    } else box.textContent = t.short ?? initials(t.name);
    return box;
  }

  function header(d: MatchDetail) {
    const played = d.status === 'ft' || d.status === 'live';
    const state = d.status === 'live' ? `LIVE${d.clock && d.clock !== 'LIVE' ? ' ' + d.clock : ''}` : d.status === 'ft' ? 'FT' : d.status === 'postponed' ? 'Postponed' : fmtDate(d.kickoff);
    const mid = h('div', 'mc-mid',
      h('div', 'mc-score', played ? `${d.home.score ?? 0} – ${d.away.score ?? 0}` : d.status === 'scheduled' && d.kickoff ? fmtTime(d.kickoff) : '–'),
      h('small', d.status === 'live' ? 'mc-live' : '', state));
    const meta = [d.competition, d.round, d.kickoff && d.status !== 'scheduled' ? fmtDate(d.kickoff) : '', d.venue].filter(Boolean).join(' · ');
    return h('div', null,
      h('div', 'mc-head',
        h('div', 'mc-team', crest(d.home), h('div', 'mc-tm', d.home.name)), mid,
        h('div', 'mc-team', crest(d.away), h('div', 'mc-tm', d.away.name))),
      h('p', 'mc-meta', meta));
  }

  // ---- timeline ----
  function evIcon(e: MatchEvent) {
    if (e.type === 'yellow') return h('i', 'mc-card y');
    if (e.type === 'red') return h('i', 'mc-card r');
    if (e.type === 'sub') return span('mc-ic', '⇄');
    return span('mc-ic', '⚽');
  }
  function evText(e: MatchEvent) {
    const wrap = h('span', 'mc-evt');
    const label = e.type === 'penalty' ? 'Penalty' : e.type === 'own-goal' ? 'Own goal' : e.type === 'red' ? (e.note ?? 'Red card') : e.type === 'yellow' ? 'Yellow card' : e.type === 'sub' ? 'Substitution' : 'Goal';
    if (e.type === 'sub') {
      wrap.append(h('b', null, e.player), h('small', 'mc-in', 'On'));
      if (e.playerOut) wrap.append(h('small', 'mc-out', `Off: ${e.playerOut}`));
      return wrap;
    }
    wrap.append(h('b', null, e.player || label));
    const sub = [e.type === 'goal' || !e.player ? '' : label, e.assist ? `Assist: ${e.assist}` : ''].filter(Boolean).join(' · ');
    if (sub) wrap.append(h('small', null, sub));
    return wrap;
  }
  function timeline(d: MatchDetail) {
    const list = d.status === 'live' ? [...d.events].reverse() : d.events;
    const card = h('div', 'mc-card-box');
    for (const e of list) {
      const body = h('div', 'mc-evbody', evIcon(e), evText(e));
      const home = e.side === 'home';
      card.append(h('div', 'mc-ev', home ? body : h('span'), h('span', 'mc-min', e.minute), home ? h('span') : body));
    }
    return card;
  }

  // ---- lineups ----
  function chip(p: Player) {
    const badge = h('i', 'mc-pn', String(p.number ?? ''));
    if (p.captain) badge.append(h('em', null, 'C'));
    const marks = h('span', 'mc-marks');
    if (p.goals) marks.append(span('mc-ic', '⚽' + (p.goals > 1 ? `×${p.goals}` : '')));
    if (p.yellow) marks.append(h('i', 'mc-card y'));
    if (p.red) marks.append(h('i', 'mc-card r'));
    if (p.off) marks.append(span('mc-off', `↓${p.off}`));
    return h('div', 'mc-pl', badge, h('span', 'mc-nm', p.name), marks);
  }
  function pitch(l: Lineup) {
    const parts = l.formation ? l.formation.split('-').map(Number) : [];
    if (!parts.length || l.starters.length !== 11) {
      return h('div', 'mc-list', ...l.starters.map((p) => h('div', null, span('mc-no', String(p.number ?? '')), p.name, p.position ? span('mc-pos', p.position) : null)));
    }
    const rows: Player[][] = [[l.starters[0]]];
    let i = 1;
    for (const n of parts) { rows.push(l.starters.slice(i, i + n)); i += n; }
    const el = h('div', 'mc-pitch');
    el.style.gridTemplateRows = `repeat(${rows.length}, 1fr)`;
    // Forwards at the top, goalkeeper at the bottom.
    for (const r of rows.reverse()) el.append(h('div', 'mc-prow', ...r.map(chip)));
    return el;
  }
  function team(name: string, l: Lineup) {
    const bench = l.bench.length
      ? h('div', 'mc-subs', h('b', null, 'Substitutes'), ...l.bench.map((p) => h('div', null, span('mc-no', String(p.number ?? '')), p.name, p.on ? span('mc-on', `↑${p.on}`) : null, p.yellow ? h('i', 'mc-card y') : null, p.red ? h('i', 'mc-card r') : null)))
      : null;
    return h('div', 'mc-lteam',
      h('div', 'mc-lhead', h('b', null, name), l.formation ? span('mc-badge', l.formation) : null),
      l.coach ? h('p', 'mc-coach', `Coach: ${l.coach}`) : null,
      pitch(l), bench);
  }
  function lineups(d: MatchDetail) {
    const l = d.lineups!;
    return h('div', 'mc-two', team(d.home.name, l.home), team(d.away.name, l.away));
  }

  // ---- stats ----
  function stats(d: MatchDetail) {
    const card = h('div', 'mc-card-box');
    for (const s of d.stats!) {
      const total = s.home + s.away || 1;
      const unit = s.percent ? '%' : '';
      const bar = h('div', 'mc-tr', h('i'), h('i'));
      (bar.children[0] as HTMLElement).style.width = `${(s.home / total) * 100}%`;
      (bar.children[1] as HTMLElement).style.flex = '1';
      card.append(h('div', 'mc-bar', h('div', 'mc-lab', span(null, `${s.home}${unit}`), span('mc-l', s.label), span(null, `${s.away}${unit}`)), bar));
    }
    return card;
  }

  // ---- page ----
  function available(d: MatchDetail): { key: Tab; label: string; empty: string }[] {
    return [
      { key: 'timeline', label: 'Timeline', empty: '' },
      { key: 'lineups', label: 'Lineups', empty: '' },
      { key: 'stats', label: 'Stats', empty: '' },
    ].filter((t) => (t.key === 'timeline' ? d.events.length > 0 : t.key === 'lineups' ? !!d.lineups : !!d.stats?.length)) as any;
  }

  function note(d: MatchDetail): string {
    if (basic) return d.status === 'ft' || d.status === 'live' ? (d.events.length ? '' : 'More details for this match are not available.') : 'Details appear here once the match gets under way.';
    if (d.status === 'scheduled') return 'Lineups are published shortly before kick-off. Come back then.';
    if (d.status === 'postponed') return 'This match has been postponed.';
    return 'More details for this match are not available.';
  }

  function render() {
    if (!detail) return;
    const d = detail;
    const tabs = available(d);
    if (!tab || !tabs.some((t) => t.key === tab)) tab = tabs[0]?.key ?? null;
    document.title = `${d.home.name} v ${d.away.name} · Panenka Goal`;
    const scrollY = window.scrollY;
    root.replaceChildren(header(d));
    if (!tabs.length) {
      root.append(h('p', 'mc-empty', note(d)));
    } else {
      const bar = h('div', 'mc-tabs');
      bar.setAttribute('role', 'tablist');
      for (const t of tabs) {
        const b = h('button', 'mc-tab', t.label) as HTMLButtonElement;
        b.type = 'button'; b.setAttribute('role', 'tab'); b.setAttribute('aria-selected', String(t.key === tab));
        b.onclick = () => { tab = t.key; history.replaceState(null, '', `#${t.key}`); render(); };
        bar.append(b);
      }
      const panel = h('div', 'mc-panel', tab === 'timeline' ? timeline(d) : tab === 'lineups' ? lineups(d) : stats(d));
      panel.setAttribute('role', 'tabpanel');
      root.append(bar, panel);
      // Lineups are often missing before kick-off: say so rather than hiding it silently.
      if (!d.lineups && d.status !== 'ft') root.append(h('p', 'mc-hint', 'Lineups are published shortly before kick-off.'));
      else if (!d.lineups) root.append(h('p', 'mc-hint', 'Lineups are not available for this match.'));
    }
    window.scrollTo(0, scrollY);
  }

  // ---- data ----
  async function fallback(): Promise<MatchDetail | null> {
    try {
      const all = await (await fetch('/match/fallback.json')).json();
      const m = all[id];
      if (!m) return null;
      const events: MatchEvent[] = (m.goals ?? []).map((g: { player: string; team: string }, i: number): MatchEvent => ({
        minute: '', order: i, side: (g.team === m.home.name ? 'home' : 'away') as Side, type: 'goal', player: g.player,
      }));
      return { ...m, events, updatedAt: new Date().toISOString() };
    } catch { return null; }
  }

  async function load() {
    let next: MatchDetail | null = null;
    let missing = false;
    try {
      const res = await fetch(`/api/match?id=${encodeURIComponent(id)}`, { cache: 'no-store' });
      if (res.ok) next = await res.json();
      else missing = res.status === 404;
    } catch { /* offline or blocked: use the stored copy */ }
    if (next) basic = false;
    else if (!detail) {
      next = await fallback();
      basic = !!next;
      if (!next) { root.replaceChildren(h('p', 'mc-empty', missing ? 'We could not find this match.' : 'Details for this match are not available right now. Please try again shortly.')); return; }
    } else return; // keep what is on screen
    detail = next;
    if (!tab) tab = (location.hash.slice(1) as Tab) || null;
    render();
    clearTimeout(timer);
    const ko = Date.parse(detail.kickoff);
    const soon = detail.status === 'scheduled' && ko - Date.now() < 15 * 60_000 && Date.now() - ko < 4 * 3600_000;
    if (!basic && (detail.status === 'live' || soon)) timer = window.setTimeout(() => { document.hidden ? (timer = window.setTimeout(load, 30_000)) : load(); }, 30_000);
  }

  if (!id) root.replaceChildren(h('p', 'mc-empty', 'Pick a match from the fixtures to see its details.'));
  else load();
</script>

<style is:global>
  .mc { --pitch: #4f7a5a; --pitch-line: #7ea287; display: grid; gap: 14px; padding-block: 24px 40px; max-width: 1100px; }
  :root[data-theme='dark'] .mc { --pitch: #3d5f46; --pitch-line: #5e8368; }
  @media (prefers-color-scheme: dark) { :root:not([data-theme='light']) .mc { --pitch: #3d5f46; --pitch-line: #5e8368; } }
  .mc-back { font-size: 14px; font-weight: 600; text-decoration: none; color: var(--text-2); justify-self: start; }
  .mc-back:hover { color: var(--text); }
  #mc-body { display: grid; gap: 14px; }
  .mc-empty, .mc-hint { color: var(--text-3); font-size: 14.5px; margin: 0; }
  .mc-empty { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r); padding: 22px 18px; text-align: center; }
  .mc-hint { text-align: center; }
  .mc-head { background: var(--ink); color: #fff; border-radius: var(--r); padding: 18px 12px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 10px; text-align: center; }
  .mc-tm { font: 700 clamp(15px, 3.6vw, 22px)/1.15 var(--display); overflow-wrap: anywhere; }
  .mc-score { font: 700 clamp(30px, 8vw, 42px)/1 var(--display); letter-spacing: 0.04em; white-space: nowrap; }
  .mc-mid small { display: block; font-size: 11.5px; letter-spacing: 0.1em; font-weight: 700; opacity: 0.85; margin-top: 6px; text-transform: uppercase; }
  .mc-mid small.mc-live { color: #ff7378; opacity: 1; }
  .mc-crest { width: 44px; height: 44px; border-radius: 50%; margin: 0 auto 6px; display: grid; place-items: center; font: 700 13px var(--display); background: #fff; color: #111; overflow: hidden; }
  .mc-crest img { width: 100%; height: 100%; object-fit: contain; padding: 3px; }
  .mc-meta { margin: -4px 0 0; text-align: center; color: var(--text-3); font-size: 13.5px; }
  .mc-tabs { display: flex; border-bottom: 1px solid var(--line); overflow-x: auto; scrollbar-width: none; }
  .mc-tab { flex: none; border: 0; border-bottom: 3px solid transparent; margin-bottom: -1px; background: none; padding: 10px 16px; font: 600 15px var(--body); color: var(--text-2); cursor: pointer; }
  .mc-tab[aria-selected='true'] { color: var(--text); border-bottom-color: var(--brand); }
  .mc-card-box { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r); overflow: hidden; }
  .mc-ev { display: grid; grid-template-columns: minmax(0, 1fr) 56px minmax(0, 1fr); gap: 8px; padding: 10px 14px; border-top: 1px solid var(--line); align-items: center; font-size: 14.5px; }
  .mc-ev:first-child { border-top: 0; }
  .mc-min { text-align: center; font-weight: 700; color: var(--text-3); font-size: 13px; }
  .mc-evbody { display: flex; align-items: center; gap: 8px; min-width: 0; }
  .mc-ev > :first-child.mc-evbody { justify-content: flex-end; text-align: right; flex-direction: row-reverse; }
  .mc-evt { display: grid; min-width: 0; line-height: 1.3; }
  .mc-evt small { color: var(--text-3); font-size: 12.5px; }
  .mc-evt .mc-in { color: var(--win); font-weight: 600; }
  .mc-ic { font-size: 14px; flex: none; }
  .mc-card { display: inline-block; width: 10px; height: 14px; border-radius: 2px; flex: none; vertical-align: -2px; }
  .mc-card.y { background: #f5c400; } .mc-card.r { background: #d3202f; }
  .mc-two { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); gap: 20px; }
  .mc-lteam { display: grid; gap: 10px; align-content: start; }
  .mc-lhead { display: flex; justify-content: space-between; align-items: center; gap: 8px; font-size: 16px; }
  .mc-badge { background: var(--accent); color: var(--on-accent); font: 700 12px var(--body); padding: 4px 8px; border-radius: 4px; }
  .mc-coach { margin: -4px 0 0; font-size: 13px; color: var(--text-3); }
  .mc-pitch { background: var(--pitch); border: 2px solid var(--pitch-line); border-radius: 10px; padding: 14px 6px; display: grid; min-height: 460px; position: relative; }
  .mc-pitch::after { content: ''; position: absolute; left: 0; right: 0; top: 50%; border-top: 2px solid var(--pitch-line); }
  .mc-prow { display: flex; justify-content: space-around; align-items: center; position: relative; z-index: 1; gap: 2px; }
  .mc-pl { display: grid; justify-items: center; gap: 2px; font-size: 11.5px; color: #fff; font-weight: 600; text-align: center; min-width: 0; flex: 1 1 0; max-width: 92px; }
  .mc-pn { width: 38px; height: 38px; border-radius: 12px; background: #23262b; display: grid; place-items: center; font-style: normal; font-weight: 700; font-size: 14px; position: relative; color: #fff; }
  .mc-pn em { position: absolute; top: -5px; right: -5px; font-style: normal; font-size: 9.5px; background: #fff; color: #111; border-radius: 50%; width: 16px; height: 16px; display: grid; place-items: center; }
  .mc-nm { max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5); }
  .mc-marks { display: flex; gap: 4px; align-items: center; min-height: 14px; font-size: 11px; }
  .mc-off, .mc-on { font-size: 11px; font-weight: 700; }
  .mc-off { color: #ffb4b7; }
  .mc-on { color: var(--win); }
  .mc-subs, .mc-list { display: grid; gap: 6px; font-size: 14px; }
  .mc-subs > div, .mc-list > div { display: flex; align-items: center; gap: 10px; padding: 8px 12px; background: var(--surface-2); border-radius: 8px; }
  .mc-no { min-width: 22px; color: var(--text-3); font-weight: 700; }
  .mc-pos { margin-left: auto; font-size: 12px; color: var(--text-3); }
  .mc-subs .mc-on { margin-left: auto; }
  .mc-bar { display: grid; gap: 5px; padding: 12px 16px; border-top: 1px solid var(--line); }
  .mc-bar:first-child { border-top: 0; }
  .mc-lab { display: flex; justify-content: space-between; font-size: 14px; font-weight: 700; }
  .mc-lab .mc-l { font-weight: 500; color: var(--text-2); }
  .mc-tr { display: flex; height: 6px; border-radius: 3px; overflow: hidden; background: var(--line); gap: 2px; }
  .mc-tr i { display: block; background: var(--brand); }
  .mc-tr i + i { background: var(--text-3); }
</style>
