---
import Base from '../../layouts/Base.astro';
import TabBar from '../../components/TabBar.astro';
import LeaguePanel from '../../components/LeaguePanel.astro';
import { getCompetition } from '../../config/competitions';
import { getLeague } from '../../lib/data';

const comp = (slug: string) => getCompetition(slug)!;
// Tab order is fixed: the big leagues first, youth last.
const main = [
  { id: 'isl', label: 'ISL', slug: 'isl' },
  { id: 'ifl', label: 'IFL', slug: 'ifl' },
  { id: 'iwl', label: 'IWL', slug: 'iwl' },
  { id: 'iwl-2', label: 'IWL 2', slug: 'iwl-2' },
  { id: 'i-league-2', label: 'I-League 2', slug: 'i-league-2' },
  { id: 'i-league-3', label: 'I-League 3', slug: 'i-league-3' },
];
const youth = [
  { id: 'u18', label: 'U18 Elite', slug: 'elite-u18' },
  { id: 'u15', label: 'U15 Junior', slug: 'junior-u15' },
  { id: 'u13', label: 'U13 Sub-Junior', slug: 'sub-junior-u13' },
];
const tabs = [...main.map(({ id, label }) => ({ id, label })), { id: 'youth', label: 'Youth League' }];
---
<Base title="Stats" description="Points tables, top scorers and numbers for ISL, IFL, IWL, IWL 2, I-League 2, I-League 3 and the AIFF youth leagues.">
  <div class="wrap">
    <div class="pagehead">
      <p class="eyebrow">Stats</p>
      <h1>Tables &amp; numbers</h1>
      <p>Pick a league. The table comes first, with that league’s top scorers and numbers below it.</p>
    </div>
    <TabBar group="stats" tabs={tabs} />

    {main.map((t) => (
      <section class="tabpanel module-tight" data-group="stats" data-panel={t.id} hidden={t.id !== 'isl'}>
        <LeaguePanel comp={comp(t.slug)} data={getLeague(comp(t.slug))} />
      </section>
    ))}
    <section class="tabpanel module-tight" data-group="stats" data-panel="youth" hidden>
      <TabBar group="youth" tabs={youth} />
      {youth.map((t) => (
        <div class="tabpanel" data-group="youth" data-panel={t.id} hidden={t.id !== 'u18'}>
          <LeaguePanel comp={comp(t.slug)} data={getLeague(comp(t.slug))} />
        </div>
      ))}
    </section>
  </div>
</Base>

<style>
  .module-tight { padding-bottom: 36px; }
  .more { padding-bottom: 36px; }
</style>
