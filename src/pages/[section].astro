---
import Base from '../layouts/Base.astro';
import VideoCard from '../components/VideoCard.astro';
import NewsList from '../components/NewsList.astro';
import KarnatakaPlayers from '../components/KarnatakaPlayers.astro';
import StandingsTable from '../components/StandingsTable.astro';
import { SECTIONS, SECTION_KEYWORDS, type SectionKey } from '../config/site';
import { COMPETITIONS } from '../config/competitions';
import { getLeague, getNews, getSectionVideos } from '../lib/data';

export function getStaticPaths() {
  return (Object.keys(SECTIONS) as SectionKey[]).map((section) => ({ params: { section } }));
}

const HERO_BG: Record<SectionKey, string> = { mens: '/bg/banner.jpg', wofo: '/bg/crowd.jpg', youth: '/bg/here.jpg', karnataka: '/bg/trophies.jpg' };
const section = Astro.params.section as SectionKey;
const meta = SECTIONS[section];
const comps = COMPETITIONS.filter((c) => c.section === section).map((comp) => ({ comp, data: getLeague(comp) }));
const videos = getSectionVideos(section, SECTION_KEYWORDS[section], 8);
const news = getNews(section).slice(0, 12);
---
<Base title={meta.heading ?? meta.title} description={meta.blurb}>
  <header class="sec-hero bg-photo" style={`--img:url(${HERO_BG[section]})`}>
    <div class="wrap">
      <p class="kn" lang="kn">{meta.titleKn}</p>
      <h1>{meta.heading ?? meta.title}</h1>
      <p class="blurb">{meta.blurb}</p>
    </div>
  </header>

  {section === 'karnataka' ? (
    <section class="wrap module" aria-labelledby="p-h">
      <div class="mod-head"><h2 id="p-h">Karnataka-born players</h2><span class="muted pnote">ISL · IFL · IWL · IWL 2</span></div>
      <p class="lede">Our own, playing at the top. Celebrating players from Karnataka in India's leagues.</p>
      <KarnatakaPlayers />
    </section>
  ) : videos.length > 0 && (
    <section class="wrap module" aria-labelledby="v-h">
      <div class="mod-head"><h2 id="v-h">Episodes</h2><a href="/watch">All shows →</a></div>
      <div class="rail">{videos.map((v) => <VideoCard video={v} />)}</div>
    </section>
  )}

  <section class="wrap module" aria-labelledby="t-h">
    <div class="mod-head"><h2 id="t-h">Tables</h2><a href="/stats">All stats →</a></div>
    <div class="tables">
      {comps.map(({ comp, data }) => {
        const stage = data?.stages[0];
        const group = stage?.groups[0];
        const rows = group?.rows ?? [];
        return (
          <div class="panel-card tcard">
            <div class="card-head red">
              <h3>{comp.name}</h3>
              <a href={`/stats/${comp.slug}`}>Full table →</a>
            </div>
            <p class="muted meta">
              {data?.seasonLabel ?? 'Season not started'}
              {(stage?.groups.length ?? 0) > 1 && ` · ${stage!.name}, ${group!.name}`}
            </p>
            {rows.length
              ? <div class="flat"><StandingsTable rows={rows} comp={comp} compact limit={8} caption={`${comp.name} table`} /></div>
              : <p class="muted empty">The table appears once the season starts.</p>}
          </div>
        );
      })}
    </div>
  </section>

  <section class="wrap module" aria-labelledby="n-h">
    <div class="mod-head"><h2 id="n-h">News</h2><a href="/news">All news →</a></div>
    <NewsList items={news} showSummary />
  </section>
</Base>

<style>
  .sec-hero { padding-block: 48px 28px; }
  .lede { color: var(--text-2); max-width: 62ch; margin: -4px 0 16px; }
  .pnote { padding-bottom: 10px; }
  .sec-hero .kn { font-size: 16px; font-weight: 700; color: var(--brand); }
  .blurb { max-width: 60ch; font-size: 17px; margin-top: 10px; color: var(--text-2); }
  /* Equal-height table cards; the table fills each card so blocks line up. */
  .tables { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr)); gap: 20px; align-items: stretch; }
  .tcard { display: flex; flex-direction: column; }
  .meta { padding: 10px 16px 0; }
  .flat { flex: 1; padding: 10px 16px 16px; }
  @media (max-width: 560px) { .flat { padding: 8px 10px 12px; } .meta { padding-inline: 12px; } }
  .flat :global(.tbl) { height: 100%; }
  .empty { padding: 16px; }
</style>
