---
import SectionPage from '../views/SectionPage.astro';
import { sectionPaths } from '../lib/routes';

// Karnataka has its own page (src/pages/karnataka/index.astro).
export function getStaticPaths() {
  return sectionPaths();
}

const section = Astro.params.section as 'mens' | 'wofo' | 'youth';
---
<SectionPage section={section} />
