---
import Base from '../layouts/Base.astro';
import { SITE, SECTIONS } from '../config/site';
import { getShows } from '../lib/data';

const shows = getShows();
---
<Base title="About" description="Panenka Goal is a fan-made channel talking Indian and Karnataka football in Kannada. Meet the team, the shows and what we stand for.">
  <header class="bg-photo hero" style="--img:url(/bg/crowd.jpg)">
    <div class="wrap">
      <p class="eyebrow">About</p>
      <h1>Football talk, in Kannada</h1>
      <p lang="kn" class="kn tag">{SITE.taglineKn}</p>
    </div>
  </header>

  <article class="wrap module prose">
    <p class="lead">
      Panenka Goal is a fan-made channel for people who love football and think in Kannada. We talk about Indian football, Karnataka
      football, youth football and women's football, the way we would over chai before kickoff.
    </p>

    <h2>Why we exist</h2>
    <p>
      Most football conversation in India happens in English or Hindi. Plenty of us watch, argue and celebrate in Kannada, and we
      wanted a home for that. Panenka Goal is that home: honest opinions, real love for the game, and a special soft spot for the
      clubs, players and grounds of Karnataka.
    </p>

    <h2>What we cover</h2>
    <ul class="cov">
      {Object.values(SECTIONS).map((s) => <li><b>{s.heading ?? s.title}.</b> {s.blurb}</li>)}
    </ul>

    <h2>Our shows</h2>
    <div class="shows">
      {shows.map((s) => (
        <a class="show" href={`/watch/${s.slug}`}>
          <b>{s.name}</b>
          {s.nameKn && <span class="kn" lang="kn">{s.nameKn}</span>}
          <span class="muted">{s.blurb}</span>
        </a>
      ))}
    </div>

    <h2>What we believe</h2>
    <ul>
      <li>Football is better when more people can follow it in their own language.</li>
      <li>Our own players, our own leagues and our own stadiums deserve the spotlight, from the ISL to the KSFA Super Division.</li>
      <li>Women's and youth football are not side stories. They are where the future of the game is being built.</li>
      <li>We are fans first. We are not affiliated with the AIFF, the ISL or any club, and our opinions are our own.</li>
    </ul>

    <h2>Say hello</h2>
    <p>
      Got a story, a player we should know about, or a show idea? Find us on
      <a href={SITE.socials.youtube} rel="noopener">YouTube</a>,
      <a href={SITE.socials.instagram} rel="noopener">Instagram</a> and
      <a href={SITE.socials.x} rel="noopener">X</a>.
    </p>
  </article>
</Base>

<style>
  .hero { padding-block: 48px 28px; }
  .hero h1 { margin-top: 6px; }
  .tag { font-size: 20px; margin-top: 8px; }
  .prose { max-width: 72ch; display: grid; gap: 14px; margin-inline: auto; }
  .prose h2 { margin-top: 14px; }
  .lead { font-size: 19px; line-height: 1.6; color: var(--text); }
  ul { margin: 0; padding-left: 20px; display: grid; gap: 6px; }
  .shows { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 12px; }
  .show { display: grid; gap: 4px; align-content: start; padding: 14px 16px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r); text-decoration: none; color: var(--text); transition: border-color 0.15s, transform 0.2s; }
  .show:hover { border-color: var(--line-strong); transform: translateY(-2px); }
  .show .kn { color: var(--brand-text); font-weight: 700; font-size: 14px; }
</style>
