---
import Base from '../layouts/Base.astro';
import VideoCard from '../components/VideoCard.astro';
import NewsList from '../components/NewsList.astro';
import StandingsTable from '../components/StandingsTable.astro';
import MatchList from '../components/MatchList.astro';
import { SITE } from '../config/site';
import { HOME_TABLES, getCompetition } from '../config/competitions';
import { getAllMatches, getLeague, getMerch, getNews, getShows, getVideos, isShort } from '../lib/data';
import { istDay, kickoffTime, shortDate } from '../lib/format';

const shows = getShows();
const { panenka, isl } = getVideos();
const longForm = panenka.filter((v) => !isShort(v));
const hero = longForm.find((v) => v.show) ?? longForm[0] ?? panenka[0];
const showName = (slug?: string) => shows.find((s) => s.slug === slug)?.name;
const latest = panenka.filter((v) => v.id !== hero?.id).slice(0, 12);
const highlights = isl.slice(0, 3);

const news = getNews().slice(0, 10);

// "Coming up" card under ISL Highlights: next senior fixtures across leagues.
const nowIso = new Date().toISOString();
const comingUp = getAllMatches()
  .filter((m) => m.comp.section !== 'youth' && m.status === 'scheduled' && m.kickoff > nowIso)
  .sort((a, b) => a.kickoff.localeCompare(b.kickoff))
  .slice(0, 4);

// "Top scorers" card under Tables.
const islComp = getCompetition('isl')!;
const islScorers = (getLeague(islComp)?.scorers ?? []).slice(0, 5);

const tables = HOME_TABLES.map((slug) => getCompetition(slug)!)
  .map((comp) => ({ comp, data: getLeague(comp) }))
  .filter((t) => t.data && t.data.stages[0]?.groups[0]?.rows.length);

// Fixtures strip: three days either side of today (IST), all leagues.
const today = istDay(new Date().toISOString());
const days = [-3, -2, -1, 0, 1, 2, 3].map((offset) => {
  const d = new Date(`${today}T12:00:00+05:30`);
  d.setUTCDate(d.getUTCDate() + offset);
  const key = istDay(d.toISOString());
  const label = offset === 0 ? 'Today' : offset === -1 ? 'Yesterday' : offset === 1 ? 'Tomorrow'
    : d.toLocaleDateString('en-IN', { weekday: 'short', day: 'numeric', timeZone: 'Asia/Kolkata' });
  return { key, label };
});
const allMatches = getAllMatches();
const byDay = new Map(days.map((d) => [d.key, allMatches.filter((m) => istDay(m.kickoff) === d.key)]));
const groupByComp = (ms: typeof allMatches) => {
  const groups = new Map<string, typeof allMatches>();
  for (const m of ms.sort((a, b) => a.kickoff.localeCompare(b.kickoff))) groups.set(m.comp.slug, [...(groups.get(m.comp.slug) ?? []), m]);
  return [...groups.values()];
};

const spot = (slug: string, section: 'wofo' | 'karnataka' | 'youth') => {
  const comp = getCompetition(slug)!;
  const data = getLeague(comp);
  const rows = data?.stages[0]?.groups[0]?.rows ?? [];
  return { comp, rows: rows.some((r) => r.played > 0) ? rows.slice(0, 3) : [], news: getNews(section).slice(0, 2) };
};
const spotlights = [
  { title: 'WoFo', href: '/wofo', ...spot('iwl', 'wofo') },
  { title: 'Karnataka', href: '/karnataka', ...spot('bdfa-sd', 'karnataka') },
  { title: 'Youth', href: '/youth', ...spot('elite-u18', 'youth') },
];
const merchLive = getMerch().some((m) => m.status === 'live' || m.status === 'pre-order');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  sameAs: Object.values(SITE.socials),
  publisher: { '@type': 'Organization', name: SITE.name, logo: `${SITE.url}/logo-512.png` },
};
---

<Base jsonLd={jsonLd}>
  <div class="lead">
    <section class="wrap hero-grid">
      {hero && (
        <div class="hero panel-card">
          <VideoCard video={hero} size="hero" badge={showName(hero.show) ?? 'Latest'} />
        </div>
      )}
      <div class="side">
        <aside class="panel-card" aria-labelledby="isl-h">
          <div class="card-head red">
            <h2 id="isl-h">ISL Highlights</h2>
            <a href="/watch#isl-highlights">All →</a>
          </div>
          <div class="card-body stack" style="gap:14px">
            {highlights.length ? highlights.map((v) => <VideoCard video={v} size="row" />) : <p class="muted">Highlights appear here after each ISL match.</p>}
          </div>
        </aside>
        {comingUp.length > 0 && (
          <aside class="panel-card grow" aria-labelledby="next-h">
            <div class="card-head yellow">
              <h2 id="next-h">Coming up</h2>
              <a href="/stats">All fixtures →</a>
            </div>
            <ul class="next card-body">
              {comingUp.map((m) => (
                <li>
                  <span class="when"><b>{kickoffTime(m.kickoff)}</b><small>{shortDate(m.kickoff)}</small></span>
                  <span class="teams">{m.home} <i>v</i> {m.away}</span>
                  <span class="lg">{m.comp.short}</span>
                </li>
              ))}
            </ul>
          </aside>
        )}
      </div>
    </section>
  </div>

  <section class="wrap module" aria-labelledby="latest-h">
    <div class="mod-head">
      <h2 id="latest-h">Latest from Panenka</h2>
      <a href="/watch">All shows →</a>
    </div>
    <div class="chips" role="tablist" aria-label="Filter by show" data-filter-for="latest-rail">
      <button class="chip" role="tab" aria-selected="true" data-show="">All</button>
      {shows.map((s) => <button class="chip" role="tab" aria-selected="false" data-show={s.slug}>{s.name}</button>)}
    </div>
    <div class="rail" id="latest-rail">
      {latest.map((v) => (
        <div data-show={v.show ?? ''}>
          <VideoCard video={v} badge={showName(v.show) ?? (isShort(v) ? 'Short' : undefined)} />
        </div>
      ))}
    </div>
  </section>

  <section class="wrap module split">
    <div class="col" aria-labelledby="news-h">
      <div class="mod-head">
        <h2 id="news-h">News wire</h2>
        <a href="/news">All news →</a>
      </div>
      <NewsList items={news} />
    </div>
    <div class="col" aria-labelledby="tables-h">
      <div class="mod-head">
        <h2 id="tables-h">Tables</h2>
        <a href="/stats">All stats →</a>
      </div>
      <div class="panel-card">
        <div class="card-head yellow tabs-head">
          <div class="chips" role="tablist" aria-label="Competition">
            {tables.map((t, i) => (
              <button class="chip" role="tab" id={`tab-${t.comp.slug}`} aria-controls={`panel-${t.comp.slug}`} aria-selected={i === 0 ? 'true' : 'false'}>{t.comp.short}</button>
            ))}
          </div>
        </div>
        {tables.map((t, i) => (
          <div class="panel" id={`panel-${t.comp.slug}`} role="tabpanel" aria-labelledby={`tab-${t.comp.slug}`} hidden={i !== 0}>
            <p class="muted season">{t.data!.seasonLabel}</p>
            <div class="flat"><StandingsTable rows={t.data!.stages[0].groups[0].rows} comp={t.comp} compact limit={6} caption={`${t.comp.name} table`} /></div>
            <a class="full" href={`/stats/${t.comp.slug}`}>Full {t.comp.short} table →</a>
          </div>
        ))}
      </div>
      {islScorers.length > 0 && (
        <div class="panel-card">
          <div class="card-head red">
            <h3>ISL top scorers</h3>
            <a href="/stats/isl#scorers">More →</a>
          </div>
          <ol class="scorers card-body">
            {islScorers.map((p) => <li><span class="who"><b>{p.player}</b><small>{p.team}</small></span><span class="g">{p.goals}</span></li>)}
          </ol>
        </div>
      )}
    </div>
  </section>

  <section class="wrap module" aria-labelledby="fx-h">
    <div class="mod-head">
      <h2 id="fx-h">Fixtures &amp; results</h2>
      <a href="/stats">By league →</a>
    </div>
    <div class="chips days" role="tablist" aria-label="Day">
      {days.map((d) => (
        <button class="chip" role="tab" aria-controls={`day-${d.key}`} aria-selected={d.key === today ? 'true' : 'false'}>
          {d.label}{byDay.get(d.key)!.length ? <span class="n">{byDay.get(d.key)!.length}</span> : null}
        </button>
      ))}
    </div>
    {days.map((d) => (
      <div class="panel-card day" id={`day-${d.key}`} role="tabpanel" hidden={d.key !== today}>
        {byDay.get(d.key)!.length === 0 ? (
          <p class="muted empty">No matches in our leagues on this day.</p>
        ) : (
          groupByComp(byDay.get(d.key)!).map((ms) => (
            <div class="comp-group">
              <a class="comp-name" href={`/stats/${ms[0].comp.slug}`}>{ms[0].comp.name}</a>
              <MatchList matches={ms} />
            </div>
          ))
        )}
      </div>
    ))}
  </section>

  <section class="wrap module spots" aria-label="Spotlights">
    {spotlights.map((s, i) => (
      <div class={`panel-card spot s${i}`}>
        <div class={`card-head ${['red', 'yellow', 'green'][i]}`}>
          <h3><a href={s.href}>{s.title}</a></h3>
          <a href={`/stats/${s.comp.slug}`}>{s.comp.short} table →</a>
        </div>
        <div class="card-body stack" style="gap:12px">
          {s.rows.length ? (
            <ol class="mini">
              {s.rows.map((r) => <li><span>{r.team}</span><b>{r.points}</b></li>)}
            </ol>
          ) : <p class="muted">Table appears once results are in.</p>}
          {s.news.map((n) => <a class="spot-news" href={n.url} rel="noopener" target="_blank">{n.title}</a>)}
        </div>
      </div>
    ))}
  </section>

  <section class="wrap module">
    <div class="cta">
      <img src="/logo-192.png" alt="" width="72" height="72" loading="lazy" />
      <div class="cta-text">
        <p class="cta-title">{merchLive ? 'New drop is live' : 'Subscribe on YouTube'}</p>
        <p class="kn" lang="kn">{SITE.taglineKn}</p>
      </div>
      <div class="chips">
        {merchLive && <a class="chip on" href="/merch">Shop merch</a>}
        <a class="chip on" href={SITE.socials.youtube} rel="noopener">YouTube</a>
        <a class="chip" href={SITE.socials.instagram} rel="noopener">Instagram</a>
        <a class="chip" href={SITE.socials.x} rel="noopener">X</a>
      </div>
    </div>
  </section>
</Base>

<script>
  // Tabs: each tablist toggles the panels its buttons control.
  document.querySelectorAll<HTMLElement>('[role="tablist"]').forEach((list) => {
    const tabs = [...list.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    tabs.forEach((tab) =>
      tab.addEventListener('click', () => {
        tabs.forEach((t) => {
          const on = t === tab;
          t.setAttribute('aria-selected', String(on));
          const panel = t.getAttribute('aria-controls');
          if (panel) document.getElementById(panel)!.hidden = !on;
        });
        // Show filter for the video rail.
        const railId = list.dataset.filterFor;
        if (railId) {
          const show = tab.dataset.show ?? '';
          document.querySelectorAll<HTMLElement>(`#${railId} > [data-show]`).forEach((el) => {
            el.hidden = show !== '' && el.dataset.show !== show;
          });
        }
      }),
    );
  });
  // Centre "Today" in the date strip without scrolling the page.
  const strip = document.querySelector<HTMLElement>('.days');
  const today = strip?.querySelector<HTMLElement>('[aria-selected="true"]');
  if (strip && today) strip.scrollLeft = today.offsetLeft - strip.offsetLeft - (strip.clientWidth - today.offsetWidth) / 2;
</script>

<style>
  .lead { padding-block: 24px 4px; }
  .hero :global(.thumb) { border-radius: 0; }
  .hero :global(.meta) { padding: 14px 18px 18px; }
  .hero :global(.t) { font: 700 clamp(22px, 2.4vw, 28px)/1.15 var(--display); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.8fr) minmax(0, 1fr); gap: 24px; align-items: stretch; }
  .side { display: flex; flex-direction: column; gap: 16px; }
  .side .grow { flex: 1; }
  .next { list-style: none; margin: 0; display: grid; gap: 0; }
  .next li { display: grid; grid-template-columns: 58px minmax(0, 1fr) auto; gap: 12px; align-items: center; padding: 10px 0; border-bottom: 1px solid var(--line); }
  .next li:first-child { padding-top: 0; }
  .next li:last-child { border-bottom: 0; padding-bottom: 0; }
  .when { display: grid; line-height: 1.2; }
  .when b { font-size: 15px; }
  .when small { font-size: 12px; color: var(--text-3); }
  .teams { font-size: 14.5px; font-weight: 600; line-height: 1.35; }
  .teams i { font-style: normal; color: var(--text-3); font-weight: 400; margin-inline: 2px; }
  .lg { font-size: 11px; font-weight: 700; padding: 3px 6px; border-radius: 4px; background: var(--accent); color: var(--on-accent); }

  .rail { margin-top: 16px; }

  .split { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 28px; align-items: start; }
  .col { display: grid; gap: 16px; align-content: start; }
  .col > .mod-head { margin-bottom: 0; }
  .tabs-head { padding: 12px 16px; }
  .tabs-head .chip { padding: 7px 12px; font-size: 13.5px; }
  .panel { padding: 14px 16px 16px; }
  .season { margin-bottom: 10px; }
  .flat :global(.tbl) { box-shadow: none; }
  .full { display: inline-block; margin-top: 12px; font-weight: 600; font-size: 14.5px; text-decoration: none; }
  .full:hover { text-decoration: underline; }
  .scorers { list-style: none; margin: 0; counter-reset: s; }
  .scorers li { display: flex; align-items: center; gap: 12px; padding: 9px 0; border-bottom: 1px solid var(--line); counter-increment: s; }
  .scorers li:first-child { padding-top: 0; }
  .scorers li:last-child { border-bottom: 0; padding-bottom: 0; }
  .scorers li::before { content: counter(s); width: 18px; color: var(--text-3); font-weight: 600; font-size: 14px; }
  .who { display: grid; flex: 1; line-height: 1.3; }
  .who b { font-weight: 600; font-size: 15px; }
  .who small { color: var(--text-3); font-size: 13px; }
  .g { font: 700 18px/1 var(--display); color: var(--brand); min-width: 28px; text-align: right; }

  .days { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; padding-bottom: 4px; }
  .days .chip { white-space: nowrap; }
  .n { display: inline-grid; place-items: center; min-width: 18px; height: 18px; margin-left: 6px; font-size: 11px; background: var(--surface-2); color: var(--text-2); border-radius: 99px; padding: 0 5px; }
  .days .chip[aria-selected='true'] .n { background: #fff; color: var(--brand); }
  .day { margin-top: 16px; padding: 4px 20px 8px; }
  .empty { padding: 16px 0; }
  .comp-group { padding-top: 14px; }
  .comp-group + .comp-group { border-top: 1px solid var(--line); margin-top: 6px; }
  .comp-name { display: inline-block; font-size: 12.5px; font-weight: 700; letter-spacing: 0.03em; text-transform: uppercase; color: var(--brand); text-decoration: none; }
  .comp-name:hover { text-decoration: underline; }

  .spots { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; align-items: stretch; }
  .spot h3 a { color: inherit; text-decoration: none; }
  .mini { list-style: none; margin: 0; padding: 0; counter-reset: m; }
  .mini li { display: flex; justify-content: space-between; gap: 8px; padding: 8px 0; border-bottom: 1px solid var(--line); counter-increment: m; font-size: 15px; }
  .mini li:first-child { padding-top: 0; }
  .mini li span::before { content: counter(m); display: inline-block; width: 20px; color: var(--text-3); font-weight: 600; }
  .mini b { font-weight: 700; }
  .spot-news { color: var(--text-2); font-weight: 600; font-size: 14.5px; text-decoration: none; line-height: 1.4; }
  .spot-news:hover { color: var(--brand); }

  .cta {
    display: flex; align-items: center; gap: 20px; flex-wrap: wrap; padding: 22px 26px; border-radius: var(--r);
    background: var(--brand); color: #fff; box-shadow: inset 0 -4px 0 var(--accent);
  }
  .cta img { width: 64px; height: 64px; flex: none; }
  .cta-text { flex: 1; min-width: 200px; }
  .cta-title { font: 700 26px/1.1 var(--display); text-transform: uppercase; }
  .cta .kn { color: rgba(255, 255, 255, 0.85); }
  .cta .chip { background: transparent; border-color: rgba(255, 255, 255, 0.5); color: #fff; }
  .cta .chip:hover { background: rgba(255, 255, 255, 0.12); }
  .cta .chip.on { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
  @media (max-width: 960px) {
    .hero-grid, .split, .spots { grid-template-columns: minmax(0, 1fr); }
    .lead { padding-top: 14px; }
    .day { padding-inline: 14px; }
  }
</style>
