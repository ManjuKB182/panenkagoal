---
import Base from '../layouts/Base.astro';
import VideoCard from '../components/VideoCard.astro';
import NewsList from '../components/NewsList.astro';
import StandingsTable from '../components/StandingsTable.astro';
import MatchList from '../components/MatchList.astro';
import { SITE } from '../config/site';
import { HOME_TABLES, getCompetition } from '../config/competitions';
import { getAllMatches, getLeague, getNews, getShows, getVideos, isShort } from '../lib/data';
import { istDay, kickoffTime, shortDate, ytWatch } from '../lib/format';

const shows = getShows();
const { panenka, isl } = getVideos();
const longForm = panenka.filter((v) => !isShort(v));
const showName = (slug?: string) => shows.find((s) => s.slug === slug)?.name;
// Latest episodes rail: full episodes, newest first, never Shorts. "All" shows the newest 12; each show chip shows
// that show's newest 8 (Football Kathe is filmed vertically, so a show's vertical episodes count too).
const allIds = new Set(longForm.slice(0, 12).map((v) => v.id));
const showIds = new Set(shows.flatMap((s) => panenka.filter((v) => v.show === s.slug).slice(0, 8).map((v) => v.id)));
const episodes = panenka.filter((v) => allIds.has(v.id) || showIds.has(v.id));
const shortsRail = panenka.filter((v) => isShort(v) && !v.show).slice(0, 10);
// Hero slider: the five newest full episodes.
const slides = longForm.slice(0, 5);
// Hero titles: drop hashtags and keep the part before the first " | " (YouTube titles carry show names and tags after it).
const cleanTitle = (t: string) => t.replace(/#\w+/g, '').split(/\s+\|\s*/)[0].trim();
const highlights = isl.slice(0, 3);

const news = getNews().slice(0, 5);

// "Coming up" card under ISL Highlights: next senior fixtures across leagues.
const nowIso = new Date().toISOString();
const comingUp = getAllMatches()
  .filter((m) => m.comp.section !== 'youth' && m.status === 'scheduled' && m.kickoff > nowIso)
  .sort((a, b) => a.kickoff.localeCompare(b.kickoff))
  .slice(0, 4);


const tables = HOME_TABLES.map((slug) => getCompetition(slug)!)
  .map((comp) => ({ comp, data: getLeague(comp) }))
  .filter((t) => t.data && t.data.stages[0]?.groups[0]?.rows.length);

// Fixtures strip: three days either side of today (IST), all leagues.
const today = istDay(new Date().toISOString());
const days = [-3, -2, -1, 0, 1, 2, 3].map((offset) => {
  const d = new Date(`${today}T12:00:00+05:30`);
  d.setUTCDate(d.getUTCDate() + offset);
  const key = istDay(d.toISOString());
  const label = offset === 0 ? 'Today' : offset === -1 ? 'Yesterday' : offset === 1 ? 'Tomorrow'
    : d.toLocaleDateString('en-IN', { weekday: 'short', day: 'numeric', timeZone: 'Asia/Kolkata' });
  return { key, label };
});
const allMatches = getAllMatches();
const byDay = new Map(days.map((d) => [d.key, allMatches.filter((m) => istDay(m.kickoff) === d.key)]));
const groupByComp = (ms: typeof allMatches) => {
  const groups = new Map<string, typeof allMatches>();
  for (const m of ms.sort((a, b) => a.kickoff.localeCompare(b.kickoff))) groups.set(m.comp.slug, [...(groups.get(m.comp.slug) ?? []), m]);
  return [...groups.values()];
};


const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  sameAs: Object.values(SITE.socials),
  publisher: { '@type': 'Organization', name: SITE.name, logo: `${SITE.url}/logo-512.png` },
};
---

<Base jsonLd={jsonLd}>
  {slides.length > 0 && (
    <section class="stage" aria-roledescription="carousel" aria-label="Latest episodes">
      {slides.map((v, i) => (
        <div class={`slide ${i === 0 ? 'active' : ''}`} data-i={i} aria-hidden={i === 0 ? undefined : 'true'}>
          <img class="bg" src={`https://i.ytimg.com/vi/${v.id}/maxresdefault.jpg`} alt="" width="1280" height="720"
            loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'}
            onerror={`this.onerror=null;this.src='${v.thumbnail}'`} />
        </div>
      ))}
      <div class="shade" aria-hidden="true"></div>
      <div class="wrap stage-inner">
        <p class="tag kn" lang="kn">{SITE.taglineKn}</p>
        <div class="texts">
          {slides.map((v, i) => (
            <div class={`txt ${i === 0 ? 'active' : ''}`} data-i={i} aria-hidden={i === 0 ? undefined : 'true'}>
              <p class="show">{showName(v.show) ?? 'Panenka Goal'} · {shortDate(v.publishedAt)}</p>
              <h1>{cleanTitle(v.title)}</h1>
              <div class="cta-row">
                <a class="btn" href={ytWatch(v.id)} rel="noopener" tabindex={i === 0 ? undefined : -1}>
                  <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor" /></svg>
                  Watch episode
                </a>
                <a class="btn ghost" href="/armchair-gaffers" tabindex={i === 0 ? undefined : -1}>All shows</a>
              </div>
            </div>
          ))}
        </div>
        <div class="dots" role="tablist" aria-label="Choose episode">
          {slides.map((v, i) => (
            <button class={`dot ${i === 0 ? 'active' : ''}`} role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-i={i} type="button">
              <span class="bar"><span class="fill"></span></span>
              <span class="lbl">{cleanTitle(v.title)}</span>
            </button>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="wrap module duo reveal">
    <aside class="panel-card" aria-labelledby="isl-h">
      <div class="card-head red">
        <h2 id="isl-h">ISL Highlights</h2>
        <a href="/armchair-gaffers#isl-highlights">All →</a>
      </div>
      <div class="card-body hl">
        {highlights.length ? highlights.map((v) => <VideoCard video={v} size="row" />) : <p class="muted">Highlights appear here after each ISL match.</p>}
      </div>
    </aside>
    {comingUp.length > 0 && (
      <aside class="panel-card" aria-labelledby="next-h">
        <div class="card-head yellow">
          <h2 id="next-h">Coming up</h2>
          <a href="/stats">All fixtures →</a>
        </div>
        <ul class="next card-body">
          {comingUp.map((m) => (
            <li>
              <span class="when"><b>{kickoffTime(m.kickoff)}</b><small>{shortDate(m.kickoff)}</small></span>
              <span class="teams">{m.home} <i>v</i> {m.away}</span>
              <span class="lg">{m.comp.short}</span>
            </li>
          ))}
        </ul>
      </aside>
    )}
  </section>

  <div class="band bg-photo" style="--img:url(/bg/banner.jpg)">
  <section class="wrap module reveal" aria-labelledby="latest-h">
    <div class="mod-head">
      <h2 id="latest-h">Latest episodes</h2>
      <a href="/armchair-gaffers">All shows →</a>
    </div>
    <div class="chips" role="tablist" aria-label="Filter by show" data-filter-for="latest-rail">
      <button class="chip" role="tab" aria-selected="true" data-show="">All</button>
      {shows.map((s) => <button class="chip" role="tab" aria-selected="false" data-show={s.slug}>{s.name}</button>)}
    </div>
    <div class="rail" id="latest-rail">
      {episodes.map((v) => (
        <div data-show={v.show ?? ''} data-all={allIds.has(v.id) ? '1' : '0'} hidden={!allIds.has(v.id)}>
          <VideoCard video={v} badge={showName(v.show)} />
        </div>
      ))}
    </div>
  </section>

  {shortsRail.length > 0 && (
    <section class="wrap module reveal" aria-labelledby="shorts-h">
      <div class="mod-head">
        <h2 id="shorts-h">Shorts</h2>
        <a href="/armchair-gaffers#shorts">All shorts →</a>
      </div>
      <div class="rail shorts-rail">
        {shortsRail.map((v) => <VideoCard video={v} size="vertical" />)}
      </div>
    </section>
  )}

  </div>

  <div class="band bg-photo" style="--img:url(/bg/trophies.jpg)">
  <section class="wrap module split reveal">
    <div class="col" aria-labelledby="news-h">
      <div class="mod-head">
        <h2 id="news-h" class="sr-only">News and blogs</h2>
        <div class="chips nb-tabs" role="tablist" aria-label="News or blogs">
          <button class="chip" role="tab" id="tab-news" aria-controls="panel-news" aria-selected="true">News</button>
          <button class="chip" role="tab" id="tab-blogs" aria-controls="panel-blogs" aria-selected="false">Blogs</button>
        </div>
      </div>
      <div class="nb-panel" id="panel-news" role="tabpanel" aria-labelledby="tab-news">
        <NewsList items={news} />
        <a class="full" href="/news">All news →</a>
      </div>
      <div class="nb-panel" id="panel-blogs" role="tabpanel" aria-labelledby="tab-blogs" hidden>
        <ul class="news bl" id="blog-list" aria-live="polite"><li class="bl-empty">Loading blogs…</li></ul>
        <a class="full" href="/armchair-gaffers/write">All blogs →</a>
      </div>
    </div>
    <div class="col" aria-labelledby="tables-h">
      <div class="mod-head">
        <h2 id="tables-h">Tables</h2>
        <a href="/stats">All stats →</a>
      </div>
      <div class="panel-card">
        <div class="card-head yellow tabs-head">
          <div class="chips" role="tablist" aria-label="Competition">
            {tables.map((t, i) => (
              <button class="chip" role="tab" id={`tab-${t.comp.slug}`} aria-controls={`panel-${t.comp.slug}`} aria-selected={i === 0 ? 'true' : 'false'}>{t.comp.short}</button>
            ))}
          </div>
        </div>
        {tables.map((t, i) => (
          <div class="panel" id={`panel-${t.comp.slug}`} role="tabpanel" aria-labelledby={`tab-${t.comp.slug}`} hidden={i !== 0}>
            <p class="muted season">{t.data!.seasonLabel}</p>
            <div class="flat"><StandingsTable rows={t.data!.stages[0].groups[0].rows} comp={t.comp} compact limit={6} caption={`${t.comp.name} table`} /></div>
            <a class="full" href={`/stats/${t.comp.slug}`}>Full {t.comp.short} table →</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="wrap module reveal" aria-labelledby="fx-h">
    <div class="mod-head">
      <h2 id="fx-h">Fixtures &amp; results</h2>
      <a href="/stats">By league →</a>
    </div>
    <div class="chips days" role="tablist" aria-label="Day">
      {days.map((d) => (
        <button class="chip" role="tab" aria-controls={`day-${d.key}`} aria-selected={d.key === today ? 'true' : 'false'}>
          {d.label}{byDay.get(d.key)!.length ? <span class="n">{byDay.get(d.key)!.length}</span> : null}
        </button>
      ))}
    </div>
    {days.map((d) => (
      <div class="panel-card day" id={`day-${d.key}`} role="tabpanel" hidden={d.key !== today}>
        {byDay.get(d.key)!.length === 0 ? (
          <p class="muted empty">No matches in our leagues on this day.</p>
        ) : (
          groupByComp(byDay.get(d.key)!).map((ms) => (
            <div class="comp-group">
              <a class="comp-name" href={`/stats/${ms[0].comp.slug}`}>{ms[0].comp.name}</a>
              <MatchList matches={ms} />
            </div>
          ))
        )}
      </div>
    ))}
  </section>

  </div>
</Base>

<script>
  // Hero slider: advance every 7 s; the progress bar on the active dot shows the time left.
  const stage = document.querySelector<HTMLElement>('.stage');
  if (stage) {
    const parts = (sel: string) => [...stage.querySelectorAll<HTMLElement>(sel)];
    const slidesEl = parts('.slide'), textsEl = parts('.txt'), dotsEl = parts('.dot');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let cur = 0, timer = 0;
    const show = (i: number) => {
      cur = (i + slidesEl.length) % slidesEl.length;
      [slidesEl, textsEl, dotsEl].forEach((group) => group.forEach((el, j) => {
        el.classList.toggle('active', j === cur);
        if (el.classList.contains('dot')) el.setAttribute('aria-selected', String(j === cur));
        else el.toggleAttribute('aria-hidden', j !== cur);
      }));
      textsEl.forEach((el, j) => el.querySelectorAll('a').forEach((a) => (j === cur ? a.removeAttribute('tabindex') : a.setAttribute('tabindex', '-1'))));
      const img = slidesEl[cur].querySelector('img');
      if (img && img.loading === 'lazy') img.loading = 'eager';
      restart();
    };
    const restart = () => { clearTimeout(timer); if (!reduce && slidesEl.length > 1) timer = window.setTimeout(() => show(cur + 1), 7000); };
    dotsEl.forEach((d, j) => d.addEventListener('click', () => show(j)));
    stage.addEventListener('mouseenter', () => { clearTimeout(timer); stage.classList.add('paused'); });
    stage.addEventListener('mouseleave', () => { stage.classList.remove('paused'); restart(); });
    document.addEventListener('visibilitychange', () => (document.hidden ? clearTimeout(timer) : restart()));
    restart();
  }

  // Tabs: each tablist toggles the panels its buttons control.
  document.querySelectorAll<HTMLElement>('[role="tablist"]').forEach((list) => {
    const tabs = [...list.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    tabs.forEach((tab) =>
      tab.addEventListener('click', () => {
        tabs.forEach((t) => {
          const on = t === tab;
          t.setAttribute('aria-selected', String(on));
          const panel = t.getAttribute('aria-controls');
          if (panel) document.getElementById(panel)!.hidden = !on;
        });
        // Show filter for the video rail.
        const railId = list.dataset.filterFor;
        if (railId) {
          const show = tab.dataset.show ?? '';
          document.querySelectorAll<HTMLElement>(`#${railId} > [data-show]`).forEach((el) => {
            el.hidden = show === '' ? el.dataset.all !== '1' : el.dataset.show !== show;
          });
        }
      }),
    );
  });
  // Blogs tab: published Armchair Gaffers pieces load live, so a newly approved piece shows without a rebuild.
  const blogList = document.getElementById('blog-list');
  if (blogList) {
    const note = (text: string) => { const li = document.createElement('li'); li.className = 'bl-empty'; li.textContent = text; blogList.replaceChildren(li); };
    fetch('/api/write/posts')
      .then((r) => (r.ok ? r.json() : Promise.reject()))
      .then((d: { posts?: { slug: string; title: string; author: string; publishedAt: string; minutes: number }[] }) => {
        const posts = (d.posts ?? []).slice(0, 5);
        if (!posts.length) return note('No blogs yet. Be the first to write one.');
        blogList.replaceChildren(...posts.map((p) => {
          const li = document.createElement('li');
          const a = document.createElement('a');
          a.href = `/armchair-gaffers/write/${p.slug}`;
          a.textContent = p.title;
          const meta = document.createElement('p');
          meta.className = 'bl-meta';
          const date = new Date(p.publishedAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
          meta.textContent = `${p.author} · ${date} · ${p.minutes} min read`;
          li.append(a, meta);
          return li;
        }));
      })
      .catch(() => note('Blogs could not be loaded right now.'));
  }
  // Centre "Today" in the date strip without scrolling the page.
  const strip = document.querySelector<HTMLElement>('.days');
  const today = strip?.querySelector<HTMLElement>('[aria-selected="true"]');
  if (strip && today) strip.scrollLeft = today.offsetLeft - strip.offsetLeft - (strip.clientWidth - today.offsetWidth) / 2;
</script>

<style>
  /* Hero stage: dark in both themes, like a broadcast stage. */
  .stage { position: relative; overflow: hidden; background: var(--ink); color: #fff; min-height: clamp(440px, 64vh, 640px); display: flex; }
  .slide { position: absolute; inset: 0; opacity: 0; transition: opacity 1.1s ease; }
  .slide.active { opacity: 1; }
  .bg { width: 100%; height: 100%; object-fit: cover; transform: scale(1.04); }
  .slide.active .bg { animation: kenburns 9s ease-out forwards; }
  @keyframes kenburns { from { transform: scale(1.04); } to { transform: scale(1.13) translateX(-1.5%); } }
  .shade {
    position: absolute; inset: 0;
    background:
      linear-gradient(90deg, rgba(10, 11, 13, 0.94) 0%, rgba(10, 11, 13, 0.72) 38%, rgba(10, 11, 13, 0.15) 75%, rgba(10, 11, 13, 0.05) 100%),
      linear-gradient(0deg, rgba(10, 11, 13, 0.9) 0%, rgba(10, 11, 13, 0) 40%);
  }
  .stage-inner { position: relative; z-index: 1; width: 100%; display: flex; flex-direction: column; justify-content: flex-end; gap: 22px; padding-block: 40px 28px; }
  .tag { color: var(--accent); font-weight: 700; font-size: 15px; }
  .texts { display: grid; }
  .txt { grid-area: 1 / 1; max-width: 640px; display: grid; gap: 14px; align-content: end; opacity: 0; transform: translateY(14px); transition: opacity 0.6s ease, transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1); pointer-events: none; }
  .txt.active { opacity: 1; transform: none; pointer-events: auto; transition-delay: 0.25s; }
  .show { font-size: 13px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #d9dde3; }
  .txt h1 { color: #fff; font-size: clamp(30px, 4.4vw, 56px); line-height: 1.02; text-transform: uppercase; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .cta-row { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 4px; }
  .stage .btn.ghost { color: #fff; border-color: rgba(255, 255, 255, 0.45); }
  .stage .btn.ghost:hover { background: rgba(255, 255, 255, 0.1); }
  .dots { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 14px; max-width: 900px; }
  .dot { display: grid; gap: 8px; text-align: left; background: none; border: 0; padding: 0; cursor: pointer; color: rgba(255, 255, 255, 0.6); font: 500 12.5px/1.3 var(--body); }
  .dot:hover, .dot.active { color: #fff; }
  .bar { height: 3px; border-radius: 2px; background: rgba(255, 255, 255, 0.25); overflow: hidden; }
  .fill { display: block; height: 100%; width: 0; background: var(--accent); }
  .dot.active .fill { animation: fill 7s linear forwards; }
  .stage.paused .dot.active .fill { animation-play-state: paused; }
  @keyframes fill { to { width: 100%; } }
  .lbl { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  .duo { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 20px; align-items: stretch; }
  .hl { display: grid; gap: 14px; }
  .next { list-style: none; margin: 0; display: grid; gap: 0; }
  .next li { display: grid; grid-template-columns: 58px minmax(0, 1fr) auto; gap: 12px; align-items: center; padding: 10px 0; border-bottom: 1px solid var(--line); }
  .next li:first-child { padding-top: 0; }
  .next li:last-child { border-bottom: 0; padding-bottom: 0; }
  .when { display: grid; line-height: 1.2; }
  .when b { font-size: 15px; }
  .when small { font-size: 12px; color: var(--text-3); }
  .teams { font-size: 14.5px; font-weight: 600; line-height: 1.35; }
  .teams i { font-style: normal; color: var(--text-3); font-weight: 400; margin-inline: 2px; }
  .lg { font-size: 11px; font-weight: 700; padding: 3px 6px; border-radius: 4px; background: var(--accent); color: var(--on-accent); }

  .rail { margin-top: 16px; }
  .rail > [hidden] { display: none; }
  /* Shorts are 9:16, so the rail fits more of them per row. */
  .shorts-rail { margin-top: 0; grid-auto-columns: calc((100% - 6 * 16px) / 7); }
  @media (max-width: 1200px) { .shorts-rail { grid-auto-columns: calc((100% - 4 * 16px) / 5); } }
  @media (max-width: 900px) { .shorts-rail { grid-auto-columns: 30%; } }
  @media (max-width: 560px) { .shorts-rail { grid-auto-columns: 44%; } }

  .split { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 28px; align-items: start; }
  .col { display: grid; gap: 16px; align-content: start; }
  .col > .mod-head { margin-bottom: 0; }
  .nb-tabs { margin: 0; }
  .nb-panel { display: grid; gap: 4px; align-content: start; }
  .nb-panel[hidden] { display: none; }
  .bl { list-style: none; margin: 0; padding: 0; background: var(--surface); border: 1px solid var(--line); border-radius: var(--r); box-shadow: var(--shadow); overflow: hidden; }
  .bl :global(li) { display: grid; gap: 4px; padding: 14px 18px; border-bottom: 1px solid var(--line); }
  .bl :global(li:last-child) { border-bottom: 0; }
  .bl :global(a) { color: var(--text); font-weight: 600; text-decoration: none; line-height: 1.4; font-size: 16.5px; }
  .bl :global(a:hover) { color: var(--brand); }
  .bl :global(.bl-meta), .bl :global(.bl-empty) { font-size: 13px; color: var(--text-3); }
  /* Phones show three headlines; the rest live under All news / All blogs. */
  @media (max-width: 640px) {
    .nb-panel :global(.news > li:nth-child(n + 4)) { display: none; }
  }
  .tabs-head { padding: 12px 16px; }
  .tabs-head .chip { padding: 7px 12px; font-size: 13.5px; }
  .panel { padding: 14px 16px 16px; }
  .season { margin-bottom: 10px; }
  .flat :global(.tbl) { box-shadow: none; }
  .full { display: inline-block; margin-top: 12px; font-weight: 600; font-size: 14.5px; text-decoration: none; }
  .full:hover { text-decoration: underline; }
  .scorers { list-style: none; margin: 0; counter-reset: s; }
  .scorers li { display: flex; align-items: center; gap: 12px; padding: 9px 0; border-bottom: 1px solid var(--line); counter-increment: s; }
  .scorers li:first-child { padding-top: 0; }
  .scorers li:last-child { border-bottom: 0; padding-bottom: 0; }
  .scorers li::before { content: counter(s); width: 18px; color: var(--text-3); font-weight: 600; font-size: 14px; }
  .who { display: grid; flex: 1; line-height: 1.3; }
  .who b { font-weight: 600; font-size: 15px; }
  .who small { color: var(--text-3); font-size: 13px; }
  .g { font: 700 18px/1 var(--display); color: var(--brand); min-width: 28px; text-align: right; }

  .days { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; padding-bottom: 4px; }
  .days .chip { white-space: nowrap; }
  .n { display: inline-grid; place-items: center; min-width: 18px; height: 18px; margin-left: 6px; font-size: 11px; background: var(--surface-2); color: var(--text-2); border-radius: 99px; padding: 0 5px; }
  .days .chip[aria-selected='true'] .n { background: var(--accent); color: var(--on-accent); }
  .day { margin-top: 16px; padding: 4px 20px 8px; }
  .empty { padding: 16px 0; }
