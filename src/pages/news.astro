---
import Base from '../layouts/Base.astro';
import TabBar from '../components/TabBar.astro';
import NewsTiles from '../components/NewsTiles.astro';
import { SECTIONS, type SectionKey } from '../config/site';
import { getNews } from '../lib/data';

const all = getNews().slice(0, 120);
const keys = Object.keys(SECTIONS) as SectionKey[];
const tabs = [{ id: 'all', label: 'All' }, ...keys.map((k) => ({ id: k, label: SECTIONS[k].title }))];
---
<Base title="All news" description="Indian football headlines, filed by section: men's, women's, youth and Karnataka.">
  <div class="wrap body">
    <div class="pagehead">
      <p class="eyebrow">News</p>
      <h1>All news</h1>
      <p>Headlines link to the original publisher.</p>
    </div>
    <TabBar group="news" tabs={tabs} />
    <section class="tabpanel" data-group="news" data-panel="all"><NewsTiles items={all} all /></section>
    {keys.map((k) => (
      <section class="tabpanel" data-group="news" data-panel={k} hidden><NewsTiles items={all.filter((n) => n.section === k)} all /></section>
    ))}
  </div>
</Base>

<style>
  .body { padding-bottom: 48px; }
</style>
