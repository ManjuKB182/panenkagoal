---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import { SITE } from '../config/site';
import { englishPath, getLocale, localePath, t } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const { title, description = SITE.description, image = '/og.png', jsonLd } = Astro.props;
const locale = getLocale(Astro.url);
const fullTitle = title ? `${title} · ${SITE.name}` : `${SITE.name}: ${locale === 'kn' ? SITE.taglineKn : SITE.tagline}`;
const pagePath = englishPath(Astro.url.pathname);
const canonical = new URL(localePath(locale, pagePath), SITE.url).href;
const ogImage = new URL(image, SITE.url).href;
// Same page in each language; x-default points at English.
const enHref = new URL(pagePath, SITE.url).href;
const knHref = new URL(localePath('kn', pagePath), SITE.url).href;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // Apply the saved theme before first paint. With nothing saved, CSS follows the system setting.
      try { const t = localStorage.getItem('pg-theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch {}
      document.documentElement.classList.add('js');
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="kn" href={knHref} />
    <link rel="alternate" hreflang="x-default" href={enHref} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121417" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={locale === 'kn' ? 'kn_IN' : 'en_IN'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Barlow+Semi+Condensed:wght@600;700&family=Inter:wght@400;500;600;700&family=Noto+Sans+Kannada:wght@400;500;700&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Barlow+Semi+Condensed:wght@600;700&family=Inter:wght@400;500;600;700&family=Noto+Sans+Kannada:wght@400;500;700&display=swap"
      />
    </noscript>
    <link rel="preconnect" href="https://i.ytimg.com" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="sr-only" href="#main">{t(locale, 'a11y.skip')}</a>
    <Header />
    <main id="main" data-locale={locale} data-ft={t(locale, 'match.ft')} data-live={t(locale, 'match.live')}>
      <slot />
    </main>
    <Footer />
    <Analytics />
    <dialog data-yt-label={t(locale, 'a11y.youtubeVideo')} class="yt-dialog" id="yt-dialog" aria-label={t(locale, 'a11y.videoPlayer')}>
      <button type="button" class="yt-close" aria-label={t(locale, 'a11y.closeVideo')}>×</button>
      <div class="yt-box"></div>
    </dialog>
    <script>
      // Fade modules in as they scroll into view.
      const io = 'IntersectionObserver' in window
        ? new IntersectionObserver((entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io?.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' })
        : null;
      document.querySelectorAll('.reveal').forEach((el) => (io ? io.observe(el) : el.classList.add('is-in')));

      // On-site player: any [data-yt] opens the video in a dialog. Shorts (data-short) get a 9:16 frame.
      const dlg = document.getElementById('yt-dialog') as HTMLDialogElement;
      const box = dlg.querySelector<HTMLElement>('.yt-box')!;
      document.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-yt]');
        if (!btn) return;
        e.preventDefault();
        const frame = document.createElement('iframe');
        frame.src = `https://www.youtube-nocookie.com/embed/${btn.dataset.yt}?autoplay=1&rel=0`;
        frame.title = btn.dataset.title ?? dlg.dataset.ytLabel!;
        frame.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture';
        frame.allowFullscreen = true;
        box.replaceChildren(frame);
        dlg.classList.toggle('short', btn.dataset.short === '1');
        dlg.showModal();
      });
      dlg.querySelector('.yt-close')!.addEventListener('click', () => dlg.close());
      // The dialog has no padding, so a click on its own box is a click on the backdrop.
      dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
      // Stop playback on close so audio does not continue behind the page.
      dlg.addEventListener('close', () => box.replaceChildren());
    </script>
    <style>
      .yt-dialog { width: min(92vw, 1000px); max-width: none; padding: 0; border: 0; border-radius: var(--r); background: #000; overflow: hidden; }
      .yt-dialog::backdrop { background: rgba(0, 0, 0, 0.82); }
      .yt-box { aspect-ratio: 16 / 9; }
      /* The iframe is added by script, so scoped styles cannot reach it. */
      .yt-box :global(iframe) { width: 100%; height: 100%; border: 0; display: block; }
      .yt-close {
        position: absolute; top: 8px; right: 8px; z-index: 1; width: 36px; height: 36px; border-radius: 50%;
        border: 0; background: rgba(0, 0, 0, 0.6); color: #fff; font-size: 24px; line-height: 1; cursor: pointer;
      }
      .yt-close:hover { background: rgba(0, 0, 0, 0.85); }
      /* Shorts: portrait frame, sized to fit the viewport height. */
      .yt-dialog.short { width: auto; }
      .yt-dialog.short .yt-box { aspect-ratio: 9 / 16; height: min(85vh, 680px); width: calc(min(85vh, 680px) * 9 / 16); }
    </style>
  </body>
</html>
