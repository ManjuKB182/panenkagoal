---
// Writer's browse page: list of published pieces. Rendered by the English and the /kn/ page files.
import Base from '../layouts/Base.astro';
import WriteHead from '../components/WriteHead.astro';
import { localePath, t, type Locale } from '../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const href = (p: string) => localePath(locale, p);
// Client-side strings and link prefix for the script below.
const ui = {
  base: locale === 'kn' ? '/kn' : '',
  intl: locale === 'kn' ? 'kn-IN' : 'en-IN',
  locale,
  noPieces: t(locale, 'write.browse.none'),
  noPiecesAtAll: t(locale, 'write.browse.noneAtAll'),
  tileMeta: t(locale, 'write.browse.tileMeta'),
  kindFan: t(locale, 'write.kind.fan'),
  kindAnalyst: t(locale, 'write.kind.analyst'),
  loadError: t(locale, 'write.browse.loadError'),
  viewsLabel: t(locale, 'write.views.label'),
  share: t(locale, 'write.share.title'),
  shareOn: t(locale, 'write.share.on'),
  copy: t(locale, 'write.share.copy'),
  copied: t(locale, 'write.share.copied'),
};
---
<Base title={t(locale, 'write.browse.title')} description={t(locale, 'write.browse.desc')}>
  <WriteHead locale={locale} active="write" />
  <section class="wrap module" style="padding-top:12px">
    <div class="wr-bar">
      <div class="chips" role="tablist" aria-label={t(locale, 'write.browse.filterLabel')} id="wr-filter">
        <button class="chip" type="button" role="tab" data-f="all" aria-selected="true">{t(locale, 'write.browse.all')}</button>
        <button class="chip" type="button" role="tab" data-f="fan" aria-selected="false">{t(locale, 'write.browse.fans')}</button>
        <button class="chip" type="button" role="tab" data-f="analyst" aria-selected="false">{t(locale, 'write.browse.analysts')}</button>
      </div>
      <a class="btn" href={href('/armchair-gaffers/write/submit')}>{t(locale, 'write.browse.submit')}</a>
    </div>
    <div class="wr-grid" id="wr-grid" aria-live="polite"><p class="wr-empty">{t(locale, 'write.browse.loading')}</p></div>
    <p class="wr-note" style="margin-top:14px">{t(locale, 'write.browse.note')}</p>
  </section>
</Base>
<script type="application/json" id="wr-i18n" set:html={JSON.stringify(ui)} />

<script>
  // Published pieces load live from /api/write/posts, so a newly approved piece shows up without a site rebuild.
  type P = { slug: string; title: string; kind: 'fan' | 'analyst'; author: string; publishedAt: string; minutes: number; cover: string | null; views: number };
  const ui = JSON.parse(document.getElementById('wr-i18n')!.textContent!) as {
    base: string; intl: string; locale: string; noPieces: string; noPiecesAtAll: string; tileMeta: string;
    kindFan: string; kindAnalyst: string; loadError: string; viewsLabel: string;
    share: string; shareOn: string; copy: string; copied: string;
  };
  const digits = (n: number) => (ui.locale === 'kn' ? String(n).replace(/[0-9]/g, (d) => '೦೧೨೩೪೫೬೭೮೯'[Number(d)]) : String(n));
  const EYE_SVG = '<svg class="wr-eye" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><circle cx="12" cy="12" r="3" fill="none" stroke="currentColor" stroke-width="2"/></svg>';
  const SHARE_SVG = '<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 14 20 9 15 4"/><path d="M4 20v-7a4 4 0 0 1 4-4h12"/></svg>';
  const grid = document.getElementById('wr-grid')!;
  const chips = [...document.querySelectorAll<HTMLButtonElement>('#wr-filter .chip')];
  let posts: P[] = [];
  let filter = 'all';

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, text?: string) {
    const e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text !== undefined) e.textContent = text;
    return e;
  }
  // Forward arrow on each tile opens X, WhatsApp and copy-link options. It sits beside the tile link, not inside it.
  function shareMenu(p: P, articleHref: string) {
    const url = new URL(articleHref, location.origin).href;
    const box = el('div', 'wr-tile-actions');
    const btn = el('button', 'wr-tile-share') as HTMLButtonElement;
    btn.innerHTML = SHARE_SVG;
    btn.type = 'button';
    btn.setAttribute('aria-label', ui.share);
    btn.setAttribute('aria-expanded', 'false');
    const menu = el('div', 'wr-tile-menu') as HTMLDivElement;
    menu.hidden = true;
    const x = el('a', 'wr-share-btn', 'X') as HTMLAnchorElement;
    x.href = `https://x.com/intent/post?text=${encodeURIComponent(p.title)}&url=${encodeURIComponent(url)}`;
    x.target = '_blank';
    x.rel = 'noopener';
    x.setAttribute('aria-label', ui.shareOn.replace('{network}', 'X'));
    const wa = el('a', 'wr-share-btn', 'WhatsApp') as HTMLAnchorElement;
    wa.href = `https://wa.me/?text=${encodeURIComponent(`${p.title} ${url}`)}`;
    wa.target = '_blank';
    wa.rel = 'noopener';
    wa.setAttribute('aria-label', ui.shareOn.replace('{network}', 'WhatsApp'));
    const copy = el('button', 'wr-share-btn', ui.copy) as HTMLButtonElement;
    copy.type = 'button';
    copy.dataset.copy = url;
    copy.dataset.done = ui.copied;
    menu.append(x, wa, copy);
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const open = menu.hidden;
      closeMenus();
      menu.hidden = !open;
      btn.setAttribute('aria-expanded', String(open));
    });
    box.append(btn, menu);
    return box;
  }
  function closeMenus() {
    document.querySelectorAll<HTMLDivElement>('.wr-tile-menu').forEach((m) => { m.hidden = true; });
    document.querySelectorAll('.wr-tile-share').forEach((b) => b.setAttribute('aria-expanded', 'false'));
  }
  document.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('.wr-tile-actions')) closeMenus();
  });

  function render() {
    grid.replaceChildren();
    const list = posts.filter((p) => filter === 'all' || p.kind === filter);
    if (!list.length) {
      grid.append(el('p', 'wr-empty', posts.length ? ui.noPieces : ui.noPiecesAtAll));
      return;
    }
    for (const p of list) {
      const wrap = el('div', 'wr-tile-wrap');
      const a = el('a', 'wr-tile') as HTMLAnchorElement;
      a.href = `${ui.base}/armchair-gaffers/write/${p.slug}`;
      if (p.cover) {
        const img = el('img', 'wr-cover') as HTMLImageElement;
        img.src = `/api/write/photo/${p.cover}`;
        img.alt = '';
        img.loading = 'lazy';
        a.append(img);
      }
      a.append(el('span', 'wr-tag' + (p.kind === 'analyst' ? ' an' : ''), p.kind === 'analyst' ? ui.kindAnalyst : ui.kindFan));
      a.append(el('h3', '', p.title));
      const foot = el('div', 'wr-foot');
      const date = new Date(p.publishedAt).toLocaleDateString(ui.intl, { day: 'numeric', month: 'short', year: 'numeric' });
      const meta = ui.tileMeta.replace('{author}', p.author).replace('{date}', date).replace('{minutes}', digits(p.minutes));
      const views = el('span', 'wr-views');
      const viewsText = ui.viewsLabel.replace('{n}', digits(p.views));
      views.setAttribute('role', 'img');
      views.setAttribute('aria-label', viewsText);
      views.title = viewsText;
      views.innerHTML = EYE_SVG + digits(p.views);
      foot.append(el('span', '', meta), views);
      a.append(foot);
      wrap.append(a, shareMenu(p, a.href));
      grid.append(wrap);
    }
  }
  chips.forEach((c) => c.addEventListener('click', () => {
    filter = c.dataset.f!;
    chips.forEach((x) => x.setAttribute('aria-selected', String(x === c)));
    render();
  }));
  fetch('/api/write/posts')
    .then((r) => (r.ok ? r.json() : Promise.reject()))
    .then((d) => { posts = d.posts ?? []; render(); })
    .catch(() => { grid.replaceChildren(el('p', 'wr-empty', ui.loadError)); });
</script>
