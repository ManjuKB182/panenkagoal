---
// Static frame for /armchair-gaffers/write/<slug> in one locale. The Pages Function in src/lib/write-article.ts
// injects the article into #post-root at request time.
import Base from '../layouts/Base.astro';
import WriteHead from '../components/WriteHead.astro';
import { localePath, t, type Locale } from '../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const href = (p: string) => localePath(locale, p);
---
<Base title={t(locale, 'outfield.title')} description={t(locale, 'outfield.shellDescription')}>
  <WriteHead locale={locale} active="write" compact />
  <section class="wrap module wr-page" style="padding-top:12px">
    <p style="margin-bottom:14px"><a class="wr-back" href={href('/armchair-gaffers/write')}>{t(locale, 'outfield.allPieces')}</a></p>
    <div id="post-root"><p class="wr-note">{t(locale, 'outfield.openPieceBefore')} <a href={href('/armchair-gaffers/write')}>{t(locale, 'outfield.writeTab')}</a>{t(locale, 'outfield.openPieceAfter')}</p></div>
  </section>
</Base>
