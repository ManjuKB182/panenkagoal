---
// Editors only. /armchair-gaffers/review is gated by Cloudflare Access and by functions/armchair-gaffers/review.ts.
import Base from '../layouts/Base.astro';
import WriteHead from '../components/WriteHead.astro';
import { getLocale, localePath, t, type MessageKey } from '../i18n';

const locale = getLocale(Astro.url);
const href = (p: string) => localePath(locale, p);
// Strings the client script needs. The script reads them from this JSON island.
const RV_KEYS = [
  'fan', 'analyst', 'caption', 'save', 'cancel', 'approve', 'sendBack', 'edit', 'delete', 'viewLive', 'loading',
  'empty', 'signIn', 'loadFailed', 'actFailed', 'notePrompt', 'deleteConfirm', 'liveWarning', 'mailSubject',
  'photoOne', 'photoMany', 'credit', 'ownPhotos', 'noteSent', 'readPiece', 'byline', 'author', 'photoCredit',
  'noCover', 'addCover', 'photoBad',
] as const;
const S: Record<string, string> = {};
for (const k of RV_KEYS) S[k] = t(locale, `outfield.rv.${k}` as MessageKey);
const client = {
  s: S,
  dateLocale: locale === 'kn' ? 'kn-IN' : 'en-IN',
  writeBase: href('/armchair-gaffers/write'),
};
---
<Base title={t(locale, 'outfield.reviewTitle')} description={t(locale, 'outfield.reviewDescription')}>
  <WriteHead active="none" compact />
  <section class="wrap module" style="padding-top:12px">
    <p class="eyebrow">{t(locale, 'outfield.reviewEyebrow')}</p>
    <h1>{t(locale, 'outfield.reviewTitle')}</h1>
    <p class="muted" style="margin:6px 0 14px">{t(locale, 'outfield.reviewIntro')}</p>
    <div class="chips" id="rv-tabs" role="tablist" style="margin-bottom:14px">
      <button class="chip" type="button" role="tab" data-s="pending" aria-selected="true">{t(locale, 'outfield.tabPending')} <span id="n-pending"></span></button>
      <button class="chip" type="button" role="tab" data-s="published" aria-selected="false">{t(locale, 'outfield.tabPublished')} <span id="n-published"></span></button>
      <button class="chip" type="button" role="tab" data-s="sent_back" aria-selected="false">{t(locale, 'outfield.tabSentBack')} <span id="n-sent_back"></span></button>
    </div>
    <div class="wr-rev" id="rv-list" aria-live="polite"></div>
  </section>
</Base>

<script type="application/json" id="rv-i18n" is:inline set:html={JSON.stringify(client)}></script>

<script>
  type B = { t: 'p'; txt: string } | { t: 'img'; key: string; cap: string; credit: string };
  type Post = { id: number; slug: string; title: string; kind: 'fan' | 'analyst'; author_name: string; author_email: string; cover_key: string | null; body: B[]; photo_rights: string; photo_credit: string; status: string; editor_note: string | null; created_at: string };
  const cfg = JSON.parse(document.getElementById('rv-i18n')!.textContent!);
  const S: Record<string, string> = cfg.s;
  const fmt = (text: string, vars: Record<string, string>) =>
    Object.entries(vars).reduce((out, [k, v]) => out.replaceAll(`{${k}}`, v), text);
  const list = document.getElementById('rv-list')!;
  let status = 'pending';

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, cls = '', text?: string) {
    const e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text !== undefined) e.textContent = text;
    return e;
  }
  const btn = (label: string, fn: () => void, cls = 'chip') => {
    const b = el('button', cls, label); b.type = 'button'; b.addEventListener('click', fn); return b;
  };
  async function act(id: number, body: object) {
    const r = await fetch(`/api/write/review/${id}`, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) });
    const d = await r.json().catch(() => ({}));
    if (!r.ok) { alert(d.error ?? S.actFailed); return false; }
    return true;
  }

  /** Same cap as the writer's form: longest side 1600px, JPEG under 5 MB. */
  async function shrink(file: File): Promise<Blob> {
    const bmp = await createImageBitmap(file, { imageOrientation: 'from-image' } as ImageBitmapOptions);
    const scale = Math.min(1, 1600 / Math.max(bmp.width, bmp.height));
    const c = document.createElement('canvas');
    c.width = Math.round(bmp.width * scale); c.height = Math.round(bmp.height * scale);
    const ctx = c.getContext('2d')!;
    ctx.fillStyle = '#fff'; ctx.fillRect(0, 0, c.width, c.height);
    ctx.drawImage(bmp, 0, 0, c.width, c.height);
    bmp.close?.();
    for (const q of [0.85, 0.7, 0.55]) {
      const b = await new Promise<Blob | null>((res) => c.toBlob(res, 'image/jpeg', q));
      if (b && b.size <= 5 * 1024 * 1024) return b;
    }
    throw new Error('too big');
  }

  function editor(p: Post, host: HTMLElement) {
    host.replaceChildren();
    const form = el('div', 'wr-form');
    const title = el('input'); title.value = p.title;
    const author = el('input'); author.value = p.author_name; author.placeholder = S.author;
    const kind = el('select'); for (const k of ['fan', 'analyst'] as const) { const o = el('option', '', k === 'fan' ? S.fan : S.analyst); o.value = k; kind.append(o); } kind.value = p.kind;
    form.append(title, author, kind);
    const coverCredit = el('input'); coverCredit.value = p.photo_credit; coverCredit.placeholder = S.photoCredit;
    const coverBox = el('div');
    if (p.cover_key) { const im = el('img'); im.src = `/api/write/photo/${p.cover_key}`; im.style.maxHeight = '140px'; im.style.objectFit = 'contain'; coverBox.append(im, coverCredit); }
    else {
      // No cover from the writer: the editor can add one. It is saved straight away, and the form keeps unsaved text.
      const pick = el('input'); pick.type = 'file'; pick.accept = 'image/*';
      const label = el('label', 'wr-filebtn', S.addCover); label.append(pick);
      pick.addEventListener('change', async () => {
        const f = pick.files?.[0];
        if (!f) return;
        let photo: Blob;
        try { photo = await shrink(f); } catch { alert(S.photoBad); return; }
        const fd = new FormData(); fd.append('photo', photo, 'cover.jpg');
        const r = await fetch(`/api/write/review/cover/${p.id}`, { method: 'POST', body: fd });
        const d = await r.json().catch(() => ({}));
        if (!r.ok) { alert(d.error ?? S.actFailed); return; }
        const kept = draft();
        Object.assign(p, { title: kept.title, kind: kind.value as Post['kind'], author_name: kept.author_name, photo_credit: kept.photo_credit, body: kept.body as B[], cover_key: d.key as string });
        editor(p, host);
      });
      coverBox.append(el('p', 'muted', S.noCover), label);
    }
    form.append(coverBox);
    const fields = p.body.map((b) => {
      if (b.t === 'p') { const txt = el('textarea'); txt.rows = 5; txt.value = b.txt; form.append(txt); return { txt }; }
      const im = el('img'); im.src = `/api/write/photo/${b.key}`; im.style.maxHeight = '140px'; im.style.objectFit = 'contain';
      const cap = el('input'); cap.value = b.cap; cap.placeholder = S.caption;
      const credit = el('input'); credit.value = b.credit; credit.placeholder = S.photoCredit;
      form.append(im, cap, credit);
      return { cap, credit };
    });
    // What is on screen now, in the shape the save API takes.
    function draft() {
      return {
        action: 'edit', title: title.value, kind: kind.value, author_name: author.value, photo_credit: coverCredit.value,
        body: p.body.map((b, i) => (b.t === 'p'
          ? { t: 'p', txt: fields[i].txt!.value }
          : { ...b, cap: fields[i].cap!.value, credit: fields[i].credit!.value })),
      };
    }
    const row = el('div', 'wr-row');
    row.append(
      btn(S.save, async () => {
        if (await act(p.id, draft())) load();
      }, 'btn'),
      btn(S.cancel, () => host.replaceChildren(), 'chip'),
    );
    form.append(row);
    host.append(form);
  }

  function card(p: Post) {
    const c = el('div', 'wr-item');
    c.append(el('h3', '', p.title));
    const photos = p.body.filter((b) => b.t === 'img').length + (p.cover_key ? 1 : 0);
    const meta = el('div', 'muted');
    meta.append(fmt(S.byline, {
      kind: p.kind === 'analyst' ? S.analyst : S.fan,
      author: p.author_name,
      photos: fmt(photos === 1 ? S.photoOne : S.photoMany, { n: String(photos) }),
      date: new Date(p.created_at).toLocaleString(cfg.dateLocale),
    }));
    const mail = el('a', '', p.author_email) as HTMLAnchorElement;
    mail.href = `mailto:${p.author_email}?subject=${encodeURIComponent(S.mailSubject)}`;
    meta.append(mail);
    c.append(meta);
    c.append(el('div', 'muted', p.photo_rights === 'credit' ? fmt(S.credit, { credit: p.photo_credit }) : S.ownPhotos));
    if (p.editor_note) c.append(el('div', 'muted', fmt(S.noteSent, { note: p.editor_note })));

    const read = el('details');
    read.append(el('summary', '', S.readPiece));
    const art = el('div', 'wr-art');
    if (p.cover_key) { const im = el('img'); im.src = `/api/write/photo/${p.cover_key}`; im.alt = ''; art.append(im); }
    for (const b of p.body) {
      if (b.t === 'p') art.append(el('p', '', b.txt));
      else { const fg = el('figure'); const im = el('img'); im.src = `/api/write/photo/${b.key}`; im.alt = b.cap; fg.append(im, el('figcaption', '', `${b.cap}${b.credit ? ' (' + b.credit + ')' : ''}`)); art.append(fg); }
    }
    read.append(art);
    c.append(read);

    const host = el('div');
    const row = el('div', 'wr-row');
    if (p.status !== 'published') row.append(btn(S.approve, async () => { if (await act(p.id, { action: 'approve' })) load(); }, 'btn'));
    else { const v = el('a', 'chip', S.viewLive) as HTMLAnchorElement; v.href = `${cfg.writeBase}/${p.slug}`; row.append(v); }
    row.append(
      btn(S.sendBack, async () => {
        const note = prompt(S.notePrompt);
        if (note && (await act(p.id, { action: 'send_back', note }))) load();
      }),
      btn(S.edit, () => editor(p, host)),
      btn(S.delete, async () => {
        const live = p.status === 'published' ? S.liveWarning : '';
        if (confirm(fmt(S.deleteConfirm, { title: p.title, live })) && (await act(p.id, { action: 'delete' }))) load();
      }, 'chip wr-del'),
    );
    c.append(row, host);
    return c;
  }

  async function load() {
    list.replaceChildren(el('p', 'wr-empty', S.loading));
    const r = await fetch(`/api/write/review?status=${status}`);
    if (!r.ok) { list.replaceChildren(el('p', 'wr-empty', r.status === 403 ? S.signIn : S.loadFailed)); return; }
    const d = await r.json();
    for (const s of ['pending', 'published', 'sent_back']) document.getElementById(`n-${s}`)!.textContent = d.counts?.[s] ? `(${d.counts[s]})` : '';
    list.replaceChildren();
    if (!d.posts.length) list.append(el('p', 'wr-empty', S.empty));
    for (const p of d.posts as Post[]) list.append(card(p));
  }
  document.querySelectorAll<HTMLButtonElement>('#rv-tabs .chip').forEach((t) => t.addEventListener('click', () => {
    status = t.dataset.s!;
    document.querySelectorAll('#rv-tabs .chip').forEach((x) => x.setAttribute('aria-selected', String(x === t)));
    load();
  }));
  load();
</script>

<style is:global>
  .wr-del { color: var(--brand-text); border-color: var(--brand); }
</style>
