---
import type { Competition } from '../config/competitions';
import type { StandingRow } from '../lib/types';
import { digits, getLocale, t, teamName } from '../i18n';

const locale = getLocale(Astro.url);

interface Props { rows: StandingRow[]; comp: Competition; compact?: boolean; limit?: number; caption?: string }
const { rows, comp, compact = false, limit, caption } = Astro.props;
const shown = limit ? rows.slice(0, limit) : rows;
const z = comp.zones ?? {};
const zone = (pos: number) =>
  z.top && pos <= z.top ? 'top' : z.promotion && pos <= z.promotion ? 'promo' : z.relegation && pos > rows.length - z.relegation ? 'rel' : '';
const move = (r: StandingRow) => (r.prevPos && r.prevPos !== r.pos ? (r.prevPos > r.pos ? 'up' : 'down') : '');
const hasZones = Boolean(z.top || z.promotion || z.relegation);
---
<div class="tbl">
  <table>
    {caption && <caption class="sr-only">{caption}</caption>}
    <thead>
      <tr>
        <th class="l" scope="col">#</th>
        <th class="l" scope="col">{t(locale, 'table.club')}</th>
        <th scope="col" title={t(locale, 'table.played')}>{t(locale, 'table.p')}</th>
        {!compact && <th scope="col" title={t(locale, 'table.won')}>{t(locale, 'table.w')}</th>}
        {!compact && <th scope="col" title={t(locale, 'table.drawn')}>{t(locale, 'table.d')}</th>}
        {!compact && <th scope="col" title={t(locale, 'table.lost')}>{t(locale, 'table.l')}</th>}
        {!compact && <th scope="col" title={t(locale, 'table.gf')}>{t(locale, 'table.gfShort')}</th>}
        {!compact && <th scope="col" title={t(locale, 'table.ga')}>{t(locale, 'table.gaShort')}</th>}
        <th scope="col" title={t(locale, 'table.gd')}>{t(locale, 'table.gdShort')}</th>
        <th scope="col" title={t(locale, 'table.pts')}>{t(locale, 'table.ptsShort')}</th>
        {!compact && <th class="l" scope="col">{t(locale, 'table.form')}</th>}
      </tr>
    </thead>
    <tbody>
      {shown.map((r) => (
        <tr class={zone(r.pos)} data-team={r.team}>
          <td class="l pos">
            <span class="rk">{digits(locale, r.pos)}</span>
            {move(r) === 'up' && <span class="mv up" title={t(locale, 'match.up', { n: digits(locale, r.prevPos!) })}>▲</span>}
            {move(r) === 'down' && <span class="mv down" title={t(locale, 'match.down', { n: digits(locale, r.prevPos!) })}>▼</span>}
          </td>
          <td class="l team">
            <span class="tm">
              {r.logo && <img src={r.logo} alt="" width="20" height="20" loading="lazy" />}
              <span class="full">{teamName(locale, r.team)}</span>
            </span>
          </td>
          <td>{digits(locale, r.played)}</td>
          {!compact && <td>{digits(locale, r.won)}</td>}
          {!compact && <td>{digits(locale, r.drawn)}</td>}
          {!compact && <td>{digits(locale, r.lost)}</td>}
          {!compact && <td>{digits(locale, r.gf)}</td>}
          {!compact && <td>{digits(locale, r.ga)}</td>}
          <td>{digits(locale, r.gd > 0 ? `+${r.gd}` : r.gd)}</td>
          <td class="pts">{digits(locale, r.points)}</td>
          {!compact && (
            <td class="l">
              <span class="form">{(r.form ?? '').split('').map((f) => <i class={f}>{f}</i>)}</span>
            </td>
          )}
        </tr>
      ))}
    </tbody>
  </table>
  {hasZones && !compact && (
    <p class="legend">
      {z.top && <span class="lg top">{t(locale, 'table.top', { n: z.top })}{comp.slug === 'isl' ? `: ${t(locale, 'table.playoffs')}` : ''}</span>}
      {z.promotion && <span class="lg promo">{t(locale, 'table.promotion')}</span>}
      {z.relegation && <span class="lg rel">{t(locale, 'table.relegation')}</span>}
    </p>
  )}
</div>

<style>
  /* Gen Z pass: big radius, rank badges, points pill, glowing form chips. Layout and sticky columns unchanged. */
  .tbl { border-radius: 20px; border-color: var(--line); box-shadow: 0 10px 30px -18px rgba(200, 16, 46, 0.35); }
  .tbl :global(table) { border-collapse: separate; border-spacing: 0; }
  thead th { background: var(--surface-2); color: var(--text-3); font-weight: 700; letter-spacing: 0.08em; font-size: 11px; padding-block: 12px; }
  tbody td { border-bottom: 1px solid color-mix(in srgb, var(--line) 60%, transparent); padding-block: 11px; font-variant-numeric: tabular-nums; transition: background 0.15s; }
  /* # and Club stay put while the numbers scroll sideways. Opaque backgrounds so scrolled cells slide underneath. */
  .pos, thead th:nth-child(1) { position: sticky; left: 0; z-index: 2; width: 52px; min-width: 52px; max-width: 52px; }
  .team, thead th:nth-child(2) { position: sticky; left: 52px; z-index: 2; box-shadow: 6px 0 8px -6px rgba(0, 0, 0, 0.18); }
  .pos, .team { background: var(--surface); }
  thead th:nth-child(1), thead th:nth-child(2) { background: var(--surface-2); }
  .pos { padding-left: 12px !important; }
  .rk { display: inline-grid; place-items: center; min-width: 28px; height: 28px; padding-inline: 4px; border-radius: 10px; font: 800 13px/1 var(--display); color: var(--text-2); background: var(--surface-2); }
  tbody tr:nth-child(1) .rk { background: linear-gradient(135deg, #ffe259, #ffa751); color: #3a2400; box-shadow: 0 4px 12px -3px rgba(255, 167, 81, 0.7); }
  tbody tr:nth-child(2) .rk { background: linear-gradient(135deg, #e8ecf1, #b9c2cf); color: #2b3340; }
  tbody tr:nth-child(3) .rk { background: linear-gradient(135deg, #f3c7a0, #d98a4e); color: #3b1f08; }
  tr.top .pos::before { background: var(--win); }
  tr.promo .pos::before { background: var(--accent); }
  tr.rel .pos::before { background: var(--brand); }
  .pos::before { content: ''; position: absolute; left: 0; top: 10px; bottom: 10px; width: 4px; border-radius: 0 4px 4px 0; background: transparent; }
  tbody tr:hover td { background: color-mix(in srgb, var(--brand) 6%, var(--surface)); }
  /* Flex goes on an inner span: a flex <td> stops behaving like a table cell and breaks the row lines. */
  .team { min-width: 170px; white-space: normal; font-weight: 700; color: var(--text); letter-spacing: -0.01em; }
  .tm { display: flex; align-items: center; gap: 10px; }
  /* Phones: narrower club column and tighter cells so P, GD and Pts always fit. */
  @media (max-width: 560px) {
    .team { min-width: 0; width: 124px; max-width: 124px; font-size: 14px; left: 40px; line-height: 1.3; }
    thead th:nth-child(2) { left: 40px; width: 124px; min-width: 124px; max-width: 124px; }
    .pos, thead th:nth-child(1) { width: 40px; min-width: 40px; max-width: 40px; }
    .tm { gap: 8px; }
    .tm img { width: 20px; height: 20px; }
    td, th { padding-inline: 7px !important; }
    .pos { padding-left: 8px !important; }
    .rk { min-width: 24px; height: 24px; font-size: 12px; border-radius: 8px; }
  }
  .team img { width: 24px; height: 24px; object-fit: contain; flex: none; border-radius: 6px; }
  .pts { font-weight: 800; color: var(--text); }
  .pts { font-size: 15px; }
  td { color: var(--text-2); }
  .mv { font-size: 8px; margin-left: 4px; vertical-align: 2px; }
  .mv.up { color: var(--win); }
  .mv.down { color: var(--loss); }
  .form { display: inline-flex; gap: 4px; }
  .form i { width: 20px; height: 20px; display: grid; place-items: center; font: 800 10px/1 var(--body); font-style: normal; color: #fff; border-radius: 7px; }
  .form .W { background: var(--win); box-shadow: 0 0 10px -1px color-mix(in srgb, var(--win) 70%, transparent); }
  .form .D { background: var(--draw); }
  .form .L { background: var(--loss); box-shadow: 0 0 10px -1px color-mix(in srgb, var(--loss) 60%, transparent); }
  .legend { display: flex; gap: 8px; flex-wrap: wrap; padding: 12px 14px; font-size: 12px; font-weight: 600; color: var(--text-2); border-top: 1px solid var(--line); }
  .lg { display: inline-flex; align-items: center; gap: 7px; padding: 4px 10px; border-radius: 99px; background: var(--surface-2); }
  .lg::before { content: ''; width: 8px; height: 8px; border-radius: 50%; }
  .lg.top::before { background: var(--win); }
  .lg.promo::before { background: var(--accent); }
  .lg.rel::before { background: var(--brand); }
</style>
