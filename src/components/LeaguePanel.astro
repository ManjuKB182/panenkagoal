---
// One league: its table(s), then the numbers for that league only (scorers, team stats, notable results).
import StandingsTable from './StandingsTable.astro';
import TabBar from './TabBar.astro';
import type { Competition } from '../config/competitions';
import type { LeagueSnapshot } from '../lib/types';
import { teamStats, matchStats } from '../lib/numbers';
import { longDateTime } from '../lib/format';

interface Props { comp: Competition; data: LeagueSnapshot | null; limit?: number }
const { comp, data, limit } = Astro.props;
const hasTable = !!data && data.stages.some((s) => s.groups.some((g) => g.rows.length > 0));
const stats = teamStats(data);
const ms = matchStats(data);
const scorers = (data?.scorers ?? []).slice(0, 5);
// Stages in order; groups A to Z (natural order, so 'Group 2' comes before 'Group 10').
// Stages run in the order they are played (qualifiers first, finals last); the stage shown first is the latest one with results.
const rank = (n: string) => /pre-?qualif/i.test(n) ? 0 : /qualif/i.test(n) ? 1 : /prelim/i.test(n) ? 2 : /stage 1|^league$/i.test(n) ? 3 : /zonal/i.test(n) ? 4 : /group/i.test(n) ? 5 : /stage 2/i.test(n) ? 6 : /play-?off/i.test(n) ? 7 : /final|knockout|semi/i.test(n) ? 8 : 5;
const stages = (data?.stages ?? [])
  .map((st) => ({ ...st, groups: [...st.groups].filter((g) => g.rows.length).sort((a, b) => a.name.localeCompare(b.name, undefined, { numeric: true })) }))
  .filter((st) => st.groups.length)
  .sort((a, b) => rank(a.name) - rank(b.name) || a.name.localeCompare(b.name));
const started = (st: (typeof stages)[number]) => st.groups.some((g) => g.rows.some((r) => r.played > 0));
const current = Math.max(0, stages.map(started).lastIndexOf(true));
const score = (m: { homeScore?: number; awayScore?: number }) => `${m.homeScore}–${m.awayScore}`;
---
<div class="lp">
  <div class="lp-head">
    <div>
      <h2>{comp.name}</h2>
      <p class="muted">{data?.seasonLabel ?? 'Season not started'}{data?.updatedAt && <> · Updated {longDateTime(data.updatedAt)}</>}</p>
    </div>
    <a class="full" href={`/stats/${comp.slug}`}>Fixtures &amp; results →</a>
  </div>

  {hasTable ? (
    <>
      {stages.length > 1 && <TabBar group={`${comp.slug}-st`} tabs={stages.map((st, i) => ({ id: `s${i}`, label: st.name }))} first={`s${current}`} />}
      {stages.map((stage, i) => (
        <div class="tabpanel stage" data-group={`${comp.slug}-st`} data-panel={`s${i}`} hidden={i !== current}>
          {stage.groups.length > 1 && <TabBar pill={stage.groups.length <= 4} select={stage.groups.length > 4} label="Group" group={`${comp.slug}-g${i}`} tabs={stage.groups.map((g, j) => ({ id: `g${j}`, label: g.name }))} />}
          {stage.groups.map((g, j) => (
            <div class="tabpanel" data-group={`${comp.slug}-g${i}`} data-panel={`g${j}`} hidden={j !== 0}>
              <StandingsTable rows={g.rows} comp={comp} limit={limit} caption={`${comp.name} ${stage.name} ${g.name}`.trim()} />
            </div>
          ))}
        </div>
      ))}
    </>
  ) : <p class="note">The table appears once the season starts.</p>}

  <h2 class="numh">{comp.short} numbers</h2>
  {scorers.length === 0 && stats.length === 0 ? <p class="muted">Numbers appear after the first results.</p> : (
    <div class="nums">
      {scorers.length > 0 && (
        <section class="panel-card">
          <div class="card-head red"><h3>Top scorers</h3></div>
          <ol class="scorers card-body">
            {scorers.map((p, i) => <li><span class="rk">{i + 1}</span><span class="who"><b>{p.player}</b><small>{p.team}</small></span><span class="g">{p.goals}</span></li>)}
          </ol>
        </section>
      )}
      {stats.length > 0 && (
        <section class="panel-card">
          <div class="card-head yellow"><h3>Team numbers</h3></div>
          <ul class="card-body kv">
            {stats.map((s) => <li><span class="k">{s.label}</span><span class="v"><b>{s.team}</b><small>{s.value}{s.note && ` · ${s.note}`}</small></span></li>)}
          </ul>
        </section>
      )}
      {ms.count > 0 && (
        <section class="panel-card">
          <div class="card-head green"><h3>Goals &amp; results</h3></div>
          <ul class="card-body kv">
            <li><span class="k">Goals scored</span><span class="v"><b>{ms.goals}</b><small>in {ms.count} matches · {ms.perMatch.toFixed(1)} per match</small></span></li>
            {ms.biggest.slice(0, 1).map((m) => <li><span class="k">Biggest win</span><span class="v"><b>{m.home} {score(m)} {m.away}</b></span></li>)}
            {ms.topScoring.slice(0, 1).filter((m) => m.homeScore + m.awayScore > 0).map((m) => <li><span class="k">Highest scoring</span><span class="v"><b>{m.home} {score(m)} {m.away}</b></span></li>)}
          </ul>
        </section>
      )}
    </div>
  )}
</div>

<style>
  .lp { display: grid; gap: 22px; }
  .lp-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 12px; flex-wrap: wrap; }
  .lp-head .full { font-size: 14px; font-weight: 600; text-decoration: none; }
  .stage > :global(.chips) { margin-bottom: 14px; }
  .numh { margin-top: 10px; padding-bottom: 8px; border-bottom: 1px solid var(--line); }
  .nums { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: 16px; align-items: stretch; }
  .nums .panel-card { display: flex; flex-direction: column; }
  .scorers { list-style: none; margin: 0; display: grid; gap: 0; }
  .scorers li { display: grid; grid-template-columns: 22px 1fr auto; gap: 10px; align-items: center; padding: 8px 0; border-bottom: 1px solid var(--line); }
  .scorers li:last-child { border-bottom: 0; }
  .rk { color: var(--text-3); font-weight: 700; font-size: 13px; }
  .who { display: grid; line-height: 1.25; }
  .who small, .v small { color: var(--text-3); font-size: 12.5px; }
  .g { font: 700 20px var(--display); }
  .kv { list-style: none; margin: 0; display: grid; }
  .kv li { display: grid; grid-template-columns: 120px 1fr; gap: 10px; padding: 9px 0; border-bottom: 1px solid var(--line); align-items: start; }
  .kv li:last-child { border-bottom: 0; }
  .k { color: var(--text-3); font-size: 13px; font-weight: 600; padding-top: 2px; }
  .v { display: grid; line-height: 1.3; }
</style>
