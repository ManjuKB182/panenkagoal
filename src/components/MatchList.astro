---
import type { Match } from '../lib/types';
import { kickoffTime, shortDate } from '../lib/format';

interface Props { matches: Match[]; showDate?: boolean }
const { matches, showDate = false } = Astro.props;
// Kicked off hours ago but no result recorded yet: say so instead of showing the kick-off time as if it were upcoming.
const overdue = (m: Match) => m.status === 'scheduled' && Date.now() - new Date(m.kickoff).getTime() > 3.5 * 3600_000;
---
<ul class="ml">
  {matches.map((m) => (
    <li data-mid={m.id} data-ko={m.kickoff}>
      <a class="row" href={`/match?id=${encodeURIComponent(m.id)}`} aria-label={`${m.home} v ${m.away}: match details`}>
      <span class="h">{m.home}</span>
      <span class={`st ${m.status}`}>
        {m.status === 'ft' || m.status === 'live' ? (
          <><b>{m.homeScore} – {m.awayScore}</b><small>{m.status === 'ft' ? 'FT' : 'LIVE'}</small></>
        ) : m.status === 'postponed' ? (
          <small>Postponed</small>
        ) : (
          <><b>{kickoffTime(m.kickoff)}</b>{overdue(m) ? <small>Result awaited</small> : showDate && <small>{shortDate(m.kickoff)}</small>}</>
        )}
        {(m.status === 'ft') && showDate && <small>{shortDate(m.kickoff)}</small>}
      </span>
      <span class="a">{m.away}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .ml { list-style: none; margin: 0; padding: 0; }
  li { border-bottom: 1px solid var(--line); font-size: 15.5px; font-weight: 600; }
  li:last-child { border-bottom: 0; }
  .row { display: grid; grid-template-columns: minmax(0, 1fr) 96px minmax(0, 1fr); gap: 12px; align-items: center; padding: 12px 6px; margin-inline: -6px; border-radius: 8px; color: inherit; text-decoration: none; }
  .row:hover { background: var(--surface-2); }
  .h { text-align: right; }
  .st { display: grid; justify-items: center; line-height: 1.25; }
  .st :global(b) { font-weight: 700; font-size: 16px; padding: 3px 10px; border-radius: 6px; background: var(--surface-2); color: var(--text); }
  .st :global(small) { font-size: 11.5px; font-weight: 600; color: var(--text-3); margin-top: 3px; }
  .st.live :global(b) { background: var(--brand-tint); color: var(--brand); }
  .st.live :global(small) { color: var(--brand); font-weight: 700; }
  .st.live :global(small)::before { content: ''; display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--brand); margin-right: 5px; vertical-align: 1px; animation: pulse 1.4s ease-in-out infinite; }
  @keyframes pulse { 50% { opacity: 0.25; } }
</style>
