---
import type { Match } from '../lib/types';
import { kickoffTime, shortDate } from '../lib/format';
import { digits, getLocale, localePath, t, teamName } from '../i18n';

const locale = getLocale(Astro.url);

interface Props { matches: Match[]; showDate?: boolean }
const { matches, showDate = false } = Astro.props;
// Kicked off hours ago but no result recorded yet: say so instead of showing the kick-off time as if it were upcoming.
const overdue = (m: Match) => m.status === 'scheduled' && Date.now() - new Date(m.kickoff).getTime() > 3.5 * 3600_000;
---
<ul class="ml">
  {matches.map((m) => (
    <li data-mid={m.id} data-ko={m.kickoff}>
      <a class="row" href={localePath(locale, `/match?id=${encodeURIComponent(m.id)}`)} aria-label={t(locale, 'match.details', { home: teamName(locale, m.home), away: teamName(locale, m.away) })}>
      <span class="h">{teamName(locale, m.home)}{m.homeLogo && <img src={m.homeLogo} alt="" width="22" height="22" loading="lazy" />}</span>
      <span class={`st ${m.status}`}>
        {m.status === 'ft' || m.status === 'live' ? (
          <><b>{digits(locale, m.homeScore!)} – {digits(locale, m.awayScore!)}</b><small>{m.status === 'ft' ? t(locale, 'match.ft') : t(locale, 'match.live')}</small></>
        ) : m.status === 'postponed' ? (
          <small>{t(locale, 'match.postponed')}</small>
        ) : (
          <><b>{kickoffTime(m.kickoff, locale)}</b>{overdue(m) ? <small>{t(locale, 'match.resultAwaited')}</small> : showDate && <small>{shortDate(m.kickoff, locale)}</small>}</>
        )}
        {(m.status === 'ft') && showDate && <small>{shortDate(m.kickoff, locale)}</small>}
      </span>
      <span class="a">{m.awayLogo && <img src={m.awayLogo} alt="" width="22" height="22" loading="lazy" />}{teamName(locale, m.away)}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  /* Gen Z pass: each fixture is its own rounded card, score is a sticker pill, live pulses neon. */
  .ml { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  li { font-size: 15.5px; font-weight: 700; letter-spacing: -0.01em; }
  .row { display: grid; grid-template-columns: minmax(0, 1fr) 104px minmax(0, 1fr); gap: 12px; align-items: center; padding: 12px 14px; border-radius: 16px; background: var(--surface-2); border: 1px solid transparent; color: inherit; text-decoration: none; transition: transform 0.18s cubic-bezier(0.2, 0.9, 0.3, 1.3), border-color 0.15s, background 0.15s; }
  .row:hover { transform: translateY(-2px) scale(1.005); border-color: color-mix(in srgb, var(--brand) 45%, transparent); background: var(--surface); }
  .row:active { transform: scale(0.985); }
  .h, .a { display: flex; align-items: center; gap: 10px; min-width: 0; }
  .h { justify-content: flex-end; text-align: right; }
  .h img, .a img { width: 26px; height: 26px; object-fit: contain; flex: none; }
  .st { display: grid; justify-items: center; line-height: 1.25; }
  .st :global(b) { font: 800 17px/1 var(--display); letter-spacing: 0.02em; font-variant-numeric: tabular-nums; padding: 7px 12px; border-radius: 12px; background: var(--text); color: var(--bg); }
  .st.scheduled :global(b) { background: var(--surface); color: var(--text); box-shadow: inset 0 0 0 1.5px var(--line-strong); font-size: 15px; }
  .st :global(small) { font-size: 11px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-3); margin-top: 5px; }
  .st.live :global(b) { background: linear-gradient(135deg, #ff3d57, #ff8a3d); color: #fff; box-shadow: 0 0 18px -2px rgba(255, 61, 87, 0.75); }
  .st.live :global(small) { color: var(--brand-text); }
  .st.live :global(small)::before { content: ''; display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--brand); margin-right: 5px; vertical-align: 1px; animation: pulse 1.4s ease-in-out infinite; }
  @keyframes pulse { 50% { opacity: 0.25; } }
  @media (prefers-reduced-motion: reduce) { .row, .st.live :global(small)::before { transition: none; animation: none; } .row:hover { transform: none; } }
  @media (max-width: 520px) {
    li { font-size: 13px; line-height: 1.25; }
    .row { grid-template-columns: minmax(0, 1fr) 70px minmax(0, 1fr); gap: 6px; padding: 10px 8px; border-radius: 14px; }
    .h, .a { gap: 6px; overflow-wrap: anywhere; hyphens: auto; }
    .h img, .a img { width: 20px; height: 20px; }
    .st :global(b) { font-size: 14.5px; padding: 6px 8px; border-radius: 10px; }
    .st.scheduled :global(b) { font-size: 13px; }
    .st :global(small) { font-size: 9.5px; }
  }
</style>
