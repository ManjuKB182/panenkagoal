---
import { NAV, SITE } from '../config/site';
import { getAllMatches } from '../lib/data';
import ScoreCard from './ScoreCard.astro';
import { kickoffTime, shortDate } from '../lib/format';

const path = Astro.url.pathname;
const active = (href: string) => path === href || path.startsWith(`${href}/`);

// Score strip: latest senior results, then the next fixtures.
const senior = getAllMatches().filter((m) => m.comp.section !== 'youth');
const results = senior.filter((m) => m.status === 'ft').sort((a, b) => b.kickoff.localeCompare(a.kickoff)).slice(0, 5).reverse();
// Matches that kicked off in the last 3 hours stay in the strip so the live script can update them.
const recent = new Date(Date.now() - 3 * 3600_000).toISOString();
const next = senior.filter((m) => (m.status === 'scheduled' && m.kickoff > recent) || m.status === 'live').sort((a, b) => a.kickoff.localeCompare(b.kickoff)).slice(0, 7);
const strip = [...results, ...next];
const short = (name: string, code?: string) => code ?? name.replace(/\b(FC|SC|Football Club)\b/g, '').trim().slice(0, 14);
// With enough cards the strip loops slowly on its own (paused on hover); the list is rendered twice for a seamless loop.
const pinned = strip.filter((m) => m.status === 'live');
const moving = strip.filter((m) => m.status !== 'live');
const loop = moving.length >= 6;
---
<header class="site-header">
  <div class="wrap bar">
    <a class="mark" href="/" aria-label={`${SITE.name} home`}>
      <picture><source srcset="/logo-96.webp" type="image/webp" /><img src="/logo-96.png" alt="" width="44" height="44" /></picture>
    </a>
    <a class="word" href="/">
      <span class="name">Panenka <b>Goal</b></span>
      <span class="sub">Football in Kannada</span>
    </a>
    <nav class="main-nav" aria-label="Main">
      {NAV.filter((n) => n.href !== '/news').map((n) => <a href={n.href} aria-current={active(n.href) ? 'page' : undefined}>{n.label}</a>)}
    </nav>
    <button class="theme" type="button" id="theme-toggle" aria-label="Switch to dark mode" title="Light / dark">
      <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" fill="currentColor" /></svg>
      <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.2" fill="currentColor" /><g stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6" /></g></svg>
    </button>
    <button class="burger" type="button" id="menu-btn" aria-label="Open menu" aria-expanded="false" aria-controls="menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<div class="menu" id="menu" hidden>
  <nav aria-label="All pages">
    <a href="/" aria-current={path === '/' ? 'page' : undefined}><b>Home</b><small>Latest episodes, scores and news</small></a>
    {NAV.map((n) => <a href={n.href} aria-current={active(n.href) ? 'page' : undefined}><b>{n.label}</b><small>{n.blurb}</small></a>)}
  </nav>
</div>

{strip.length > 0 && (
  <div class="scores" aria-label="Latest results and next fixtures">
    <div class="pin" id="pin" aria-label="Live now">
      {pinned.map((m) => <ScoreCard m={m} copy={0} short={short(m.home, m.homeShort)} shortAway={short(m.away, m.awayShort)} />)}
    </div>
    <div class="ticker">
      <div class={`track ${loop ? 'loop' : ''}`} id="track">
        {(loop ? [0, 1] : [0]).map((copy) => (
          <div class="set" aria-hidden={copy === 1 ? 'true' : undefined}>
            {moving.map((m) => <ScoreCard m={m} copy={copy} short={short(m.home, m.homeShort)} shortAway={short(m.away, m.awayShort)} />)}
          </div>
        ))}
      </div>
    </div>
  </div>
)}

<script>
  // Live scores: patch any match on the page (data-mid) from /api/live. Polls every 30 s only while a match is on or about to start.
  type Live = { id: string; state: 'live' | 'ft' | 'scheduled'; homeScore?: number; awayScore?: number; clock?: string };
  const targets = [...document.querySelectorAll<HTMLElement>('[data-mid]')];
  const near = () => targets.some((el) => { const d = Date.now() - new Date(el.dataset.ko!).getTime(); return d > -10 * 60_000 && d < 3.5 * 3600_000; });
  // A live card moves out of the scrolling ticker into the fixed "pin" on the left; at full time it goes back.
  const pinBox = document.getElementById('pin');
  const sets = () => [...document.querySelectorAll<HTMLElement>('#track .set')];
  const pin = (id: string) => {
    if (!pinBox || pinBox.querySelector(`[data-card="${id}"]`)) return;
    const cards = [...document.querySelectorAll<HTMLElement>(`#track [data-card="${id}"]`)];
    const first = cards.find((c) => c.dataset.mid);
    if (!first) return;
    cards.filter((c) => c !== first).forEach((c) => c.remove());
    pinBox.append(first);
  };
  const unpin = (id: string) => {
    const el = pinBox?.querySelector<HTMLElement>(`[data-card="${id}"]`);
    if (!el) return;
    const [a, b] = sets();
    const twin = el.cloneNode(true) as HTMLElement;
    twin.removeAttribute('data-mid'); twin.tabIndex = -1;
    a?.append(el); b?.append(twin);
  };
  const apply = (m: Live) => {
    if (m.state === 'scheduled') return;
    const score = `${m.homeScore} – ${m.awayScore}`;
    const label = m.state === 'ft' ? 'FT' : `LIVE${m.clock && m.clock !== 'LIVE' ? ' ' + m.clock : ''}`;
    if (m.state === 'live') pin(m.id);
    if (m.state === 'ft') unpin(m.id);
    document.querySelectorAll<HTMLElement>(`[data-mid="${m.id}"]`).forEach((el) => {
      if (el.classList.contains('sc')) {
        const st = el.querySelector<HTMLElement>('[data-state]')!;
        st.textContent = label; st.className = `state ${m.state}`;
        const [h, a] = [m.homeScore!, m.awayScore!];
        const sides = { home: el.querySelector<HTMLElement>('[data-side=home]')!, away: el.querySelector<HTMLElement>('[data-side=away]')! };
        sides.home.textContent = String(h); sides.away.textContent = String(a);
        sides.home.className = m.state === 'ft' && h > a ? 'w' : ''; sides.away.className = m.state === 'ft' && a > h ? 'w' : '';
      } else {
        const st = el.querySelector<HTMLElement>('.st');
        if (!st) return;
        st.className = `st ${m.state}`;
        st.innerHTML = '';
        const b = document.createElement('b'); b.textContent = score;
        const s = document.createElement('small'); s.textContent = label;
        st.append(b, s);
      }
    });
  };
  const tick = async () => {
    if (document.hidden) return schedule();
    try {
      const res = await fetch('/api/live', { cache: 'no-store' });
      const data: { matches: Live[] } = await res.json();
      data.matches.forEach(apply);
      if (data.matches.some((m) => m.state === 'live') || near()) schedule();
    } catch { /* keep the last known scores */ }
  };
  const schedule = () => setTimeout(tick, 30_000);
  if (targets.length) tick();
</script>

<script>
  // Phone menu: the hamburger opens a full list of pages; Escape or a tap on a link closes it.
  const mbtn = document.getElementById('menu-btn')!;
  const menu = document.getElementById('menu')!;
  const setMenu = (open: boolean) => {
    if (open) menu.style.setProperty('--menu-top', `${Math.round(document.querySelector('.site-header')!.getBoundingClientRect().bottom)}px`);
    menu.hidden = !open;
    mbtn.setAttribute('aria-expanded', String(open));
    mbtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    document.documentElement.classList.toggle('menu-open', open);
  };
  mbtn.addEventListener('click', () => setMenu(menu.hidden));
  menu.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) setMenu(false); });
  addEventListener('keydown', (e) => { if (e.key === 'Escape') setMenu(false); });
  matchMedia('(min-width: 961px)').addEventListener('change', (e) => { if (e.matches) setMenu(false); });
</script>

<script>
  const btn = document.getElementById('theme-toggle')!;
  const root = document.documentElement;
  const isDark = () => root.dataset.theme === 'dark' || (!root.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
  const label = () => btn.setAttribute('aria-label', isDark() ? 'Switch to light mode' : 'Switch to dark mode');
  label();
  btn.addEventListener('click', () => {
    const next = isDark() ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('pg-theme', next); } catch {}
    label();
  });
</script>

<style>
  .site-header {
    position: sticky; top: env(safe-area-inset-top, 0px); z-index: 30;
    background: color-mix(in srgb, var(--header-bg) 92%, transparent);
    backdrop-filter: saturate(1.4) blur(12px); -webkit-backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid var(--line);
  }
  /* A thin flag stripe is the only large use of the brand colours. */
  .site-header::before { content: ''; display: block; height: 3px; background: linear-gradient(90deg, var(--accent) 0 50%, var(--brand) 50% 100%); }
  .bar { display: flex; align-items: center; gap: 14px; min-height: 64px; }
  .mark { flex: none; display: block; }
  .mark img { width: 44px; height: 44px; transition: transform 0.3s ease; }
  .mark:hover img { transform: rotate(-12deg); }
  .word { display: grid; line-height: 1.05; text-decoration: none; color: var(--text); flex: none; }
  .name { font: 700 22px/1 var(--display); letter-spacing: 0.02em; text-transform: uppercase; }
  .name b { color: var(--brand-text); font-weight: 700; }
  .sub { font-size: 11px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-3); margin-top: 3px; }
  .main-nav { display: flex; align-self: stretch; margin-left: auto; }
  .word { margin-left: -4px; }
  .main-nav a {
    display: flex; align-items: center; color: var(--text-2); text-decoration: none; font-weight: 600; font-size: 15px;
    padding: 0 13px; white-space: nowrap; box-shadow: inset 0 -2px 0 transparent; transition: color 0.15s, box-shadow 0.15s;
  }
  .main-nav a:hover { color: var(--text); }
  .main-nav a[aria-current='page'] { color: var(--text); box-shadow: inset 0 -2px 0 var(--brand); }
  .theme {
    flex: none; width: 38px; height: 38px; display: grid; place-items: center; border-radius: 50%;
    border: 1px solid var(--line); background: var(--surface); color: var(--text-2); cursor: pointer; transition: color 0.15s, border-color 0.15s, transform 0.3s;
  }
  .theme:hover { color: var(--text); border-color: var(--line-strong); }
  .theme:active { transform: rotate(30deg); }
  .theme svg { width: 18px; height: 18px; }
  .sun { display: none; }
  :global(:root[data-theme='dark']) .sun { display: block; }
  :global(:root[data-theme='dark']) .moon { display: none; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .sun { display: block; }
    :global(:root:not([data-theme='light'])) .moon { display: none; }
  }

  .scores { display: flex; background: var(--strip-bg); border-bottom: 1px solid var(--line); overflow: hidden; }
  /* Live matches sit still on the left; everything else scrolls past on the right. */
  .pin { flex: none; display: flex; position: relative; z-index: 2; background: var(--strip-bg); box-shadow: 8px 0 10px -8px rgba(0, 0, 0, 0.25); }
  .pin:empty { display: none; }
  .pin :global(.sc) { background: var(--brand-tint); box-shadow: inset 0 -2px 0 var(--brand); }
  .ticker { flex: 1; min-width: 0; overflow: hidden; }
  .track { display: flex; width: max-content; }
  .track:not(.loop) { width: auto; overflow-x: auto; scrollbar-width: none; padding-inline: var(--gutter); }
  .track.loop { animation: ticker 60s linear infinite; }
  /* Phones keep scrolling even with "reduce motion" on (the global rule would freeze it); a slow marquee is the point of the strip. */
  @media (max-width: 960px) { .track.loop { animation: ticker 60s linear infinite !important; } }
  /* Pause on hover only where hover exists; on touch a tap would otherwise leave the strip stuck. */
  @media (hover: hover) { .ticker:hover .track.loop { animation-play-state: paused; } }
  .scores:focus-within .track.loop { animation-play-state: paused; }
  @keyframes ticker { to { transform: translateX(-50%); } }
  .set { display: flex; }
  .scores :global(.sc) { flex: none; width: 176px; display: grid; gap: 3px; padding: 9px 14px; color: var(--text); text-decoration: none; border-right: 1px solid var(--line); transition: background-color 0.15s; }
  .scores :global(.sc:hover) { background: var(--surface); }
  .scores :global(.sc-top) { display: flex; justify-content: space-between; gap: 8px; font-size: 11px; font-weight: 600; color: var(--text-3); }
  .scores :global(.comp) { font-weight: 700; color: var(--text-2); letter-spacing: 0.04em; }
  .scores :global(.state.ft) { color: var(--text); }
  .scores :global(.state.live) { color: var(--brand-text); font-weight: 700; }
  .scores :global(.state.live::before) { content: ''; display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--brand); margin-right: 5px; vertical-align: 1px; animation: pulse 1.4s ease-in-out infinite; }
  @keyframes pulse { 50% { opacity: 0.25; } }
  .scores :global(.row) { display: flex; justify-content: space-between; gap: 8px; font-size: 13.5px; font-weight: 600; line-height: 1.35; }
  .scores :global(.row .t) { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--text-2); }
  .scores :global(.row b) { color: var(--text-3); font-weight: 700; }
  .scores :global(.row b.w), .pin :global(.row b) { color: var(--text); }

  .burger { display: none; flex: none; width: 40px; height: 40px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); cursor: pointer; padding: 0; place-content: center; gap: 4px; }
  .burger span { display: block; width: 18px; height: 2px; border-radius: 2px; background: var(--text); transition: transform 0.2s, opacity 0.2s; }
  :global(html.menu-open) .burger span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  :global(html.menu-open) .burger span:nth-child(2) { opacity: 0; }
  :global(html.menu-open) .burger span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }
  .menu { position: fixed; inset: 0; top: var(--menu-top, 60px); z-index: 29; background: var(--header-bg); overflow-y: auto; padding: 8px var(--gutter) 40px; }
  .menu[hidden] { display: none; }
  .menu nav { display: grid; max-width: 640px; margin: 0 auto; }
  .menu a { display: grid; gap: 2px; padding: 14px 4px; border-bottom: 1px solid var(--line); text-decoration: none; color: var(--text); }
  .menu a b { font: 700 22px/1.2 var(--display); letter-spacing: 0.01em; }
  .menu a small { color: var(--text-3); font-size: 13.5px; }
  .menu a[aria-current='page'] b { color: var(--brand-text); }
  :global(html.menu-open) { overflow: hidden; }
  @media (max-width: 960px) {
    .main-nav { display: none; }
    .theme { margin-left: auto; }
    .burger { display: grid; }
    .bar { min-height: 56px; gap: 10px; }
    .mark img { width: 36px; height: 36px; }
    .name { font-size: 19px; }
    .sub { font-size: 9.5px; }
  }
@media (min-width: 961px) { .menu { display: none !important; } }
</style>
