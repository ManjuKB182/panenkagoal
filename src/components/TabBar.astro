---
// Underline tab bar. Panels are elements with data-panel="<id>" (and data-group matching `group`) placed by the page.
// Without JS every panel shows; with JS only the selected one does, and the URL hash keeps the view linkable.
interface Props { group: string; tabs: { id: string; label: string; n?: number }[]; first?: string; pill?: boolean; select?: boolean; label?: string }
const { group, tabs, first = tabs[0]?.id, pill = false, select = false, label } = Astro.props;
---
{select ? (
  <label class="sel">
    {label && <span>{label}</span>}
    <select data-tabs={group} aria-label={label ?? 'Choose'}>
      {tabs.map((t) => <option value={t.id} data-tab={t.id} selected={t.id === first}>{t.label}</option>)}
    </select>
  </label>
) : <div class={pill ? 'chips pills' : 'tabs'} role="tablist" data-tabs={group}>
  {tabs.map((t) => (
    <button class={pill ? 'chip' : 'tab'} type="button" role="tab" id={`tab-${group}-${t.id}`} data-tab={t.id} aria-selected={t.id === first ? 'true' : 'false'}>
      {t.label}{t.n ? <span class="n">{t.n}</span> : null}
    </button>
  ))}
</div>}

<script>
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((bar) => {
    const group = bar.dataset.tabs!;
    const isSel = bar instanceof HTMLSelectElement;
    const tabs = [...bar.querySelectorAll<HTMLElement>('[data-tab]')];
    const panels = [...document.querySelectorAll<HTMLElement>(`[data-group="${group}"][data-panel]`)];
    const ids = tabs.map((t) => t.dataset.tab!);
    const show = (id: string, push: boolean) => {
      if (!ids.includes(id)) id = (isSel ? (bar as HTMLSelectElement).value : tabs.find((t) => t.getAttribute('aria-selected') === 'true')?.dataset.tab) ?? ids[0];
      if (isSel) (bar as HTMLSelectElement).value = id;
      else tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.tab === id)));
      panels.forEach((p) => { p.hidden = p.dataset.panel !== id; });
      if (push) history.replaceState(null, '', `#${id}`);
      bar.dispatchEvent(new CustomEvent('tabchange', { detail: id, bubbles: true }));
    };
    if (isSel) bar.addEventListener('change', () => show((bar as HTMLSelectElement).value, true));
    else tabs.forEach((t) => t.addEventListener('click', () => show(t.dataset.tab!, true)));
    // The first tab bar on a page owns the URL hash.
    const owner = document.querySelector('[data-tabs]') === bar;
    if (owner) addEventListener('hashchange', () => show(location.hash.slice(1), false));
    show(owner ? location.hash.slice(1) : '', false);
  });
</script>

<style>
  .sel { display: inline-flex; align-items: center; gap: 10px; margin-bottom: 14px; font-weight: 600; font-size: 14px; color: var(--text-2); }
  .sel select { font: 600 14.5px var(--body); color: var(--text); background: var(--surface); border: 1px solid var(--line-strong); border-radius: 8px; padding: 9px 36px 9px 14px; min-width: 200px; cursor: pointer; }
</style>
