---
// Day strip (three days either side of today, IST) with matches grouped by competition. Every match opens its match centre.
import MatchList from './MatchList.astro';
import type { getAllMatches } from '../lib/data';
import { istDay } from '../lib/format';
import { compName } from '../config/competitions';
import { digits, getLocale, localePath, t } from '../i18n';

type Item = ReturnType<typeof getAllMatches>[number];
interface Props { matches: Item[]; id: string }
const { matches, id } = Astro.props;
const locale = getLocale(Astro.url);
const today = istDay(new Date().toISOString());
const days = [-3, -2, -1, 0, 1, 2, 3].map((offset) => {
  const d = new Date(`${today}T12:00:00+05:30`);
  d.setUTCDate(d.getUTCDate() + offset);
  const label = offset === 0 ? t(locale, 'home.today') : offset === -1 ? t(locale, 'home.yesterday') : offset === 1 ? t(locale, 'home.tomorrow')
    : digits(locale, d.toLocaleDateString(locale === 'kn' ? 'kn-IN' : 'en-IN', { weekday: 'short', day: 'numeric', timeZone: 'Asia/Kolkata' }));
  return { key: istDay(d.toISOString()), label };
});
const byDay = new Map(days.map((d) => [d.key, matches.filter((m) => istDay(m.kickoff) === d.key)]));
const groupByComp = (ms: Item[]) => {
  const groups = new Map<string, Item[]>();
  for (const m of [...ms].sort((a, b) => a.kickoff.localeCompare(b.kickoff))) groups.set(m.comp.slug, [...(groups.get(m.comp.slug) ?? []), m]);
  return [...groups.values()];
};
// If nothing is on today, open on the nearest day that has matches.
const open = byDay.get(today)!.length ? today : (days.find((d) => byDay.get(d.key)!.length)?.key ?? today);
---
<div class="fbd" data-fbd={id}>
  <div class="chips days" role="tablist" aria-label={t(locale, 'home.day')}>
    {days.map((d) => (
      <button class="chip" type="button" role="tab" data-day={d.key} aria-selected={d.key === open ? 'true' : 'false'}>
        {d.label}{byDay.get(d.key)!.length ? <span class="n">{digits(locale, byDay.get(d.key)!.length)}</span> : null}
      </button>
    ))}
  </div>
  {days.map((d) => (
    <div class="panel-card day" data-dayp={d.key} hidden={d.key !== open}>
      {byDay.get(d.key)!.length === 0 ? (
        <p class="muted empty">{t(locale, 'sections.fixtures.noDay')}</p>
      ) : (
        groupByComp(byDay.get(d.key)!).map((ms) => (
          <div class="comp-group">
            <a class="comp-name" href={localePath(locale, `/stats/${ms[0].comp.slug}`)}>{compName(locale, ms[0].comp)}</a>
            <MatchList matches={ms} />
          </div>
        ))
      )}
    </div>
  ))}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-fbd]').forEach((root) => {
    const chips = [...root.querySelectorAll<HTMLButtonElement>('[data-day]')];
    chips.forEach((c) => c.addEventListener('click', () => {
      chips.forEach((x) => x.setAttribute('aria-selected', String(x === c)));
      root.querySelectorAll<HTMLElement>('[data-dayp]').forEach((p) => { p.hidden = p.dataset.dayp !== c.dataset.day; });
    }));
  });
</script>

<style>
  /* Gen Z pass: pill day chips with a sticker count, competition headers as gradient tags. */
  .days { margin-bottom: 16px; gap: 8px; }
  .days :global(.chip) { border-radius: 99px; font-weight: 700; padding: 8px 16px; transition: transform 0.15s cubic-bezier(0.2, 0.9, 0.3, 1.4); }
  .days :global(.chip:active) { transform: scale(0.94); }
  .days :global(.chip[aria-selected='true']) { background: linear-gradient(135deg, var(--brand), #ff6a3d); border-color: transparent; color: #fff; box-shadow: 0 8px 20px -8px rgba(200, 16, 46, 0.7); }
  .days .n { margin-left: 6px; background: var(--accent); color: var(--on-accent); border-radius: 99px; font-size: 11px; padding: 1px 7px; font-weight: 800; }
  .day[hidden] { display: none; }
  .day { background: transparent; border: 0; box-shadow: none; overflow: visible; display: grid; gap: 14px; }
  .empty { padding: 28px 20px; text-align: center; background: var(--surface); border: 1.5px dashed var(--line-strong); border-radius: 20px; }
  .comp-group { padding: 14px; background: var(--surface); border: 1px solid var(--line); border-radius: 22px; box-shadow: 0 12px 30px -22px rgba(20, 22, 26, 0.5); }
  .comp-name { display: inline-block; margin-bottom: 10px; padding: 5px 12px; border-radius: 99px; font: 800 11.5px var(--body); letter-spacing: 0.08em; text-transform: uppercase; color: var(--on-accent); background: var(--accent); text-decoration: none; transition: transform 0.15s; }
  .comp-name:hover { transform: rotate(-2deg) scale(1.04); }
</style>
