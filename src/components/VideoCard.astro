---
import type { Video } from '../lib/types';
import { timeAgo, ytWatch } from '../lib/format';

interface Props { video: Video; badge?: string; size?: 'hero' | 'tile' | 'row' | 'vertical'; play?: boolean }
const { video, badge, size = 'tile', play = size === 'hero' } = Astro.props;
---
<article class={`vc ${size}`}>
  {play ? (
    <a class="thumb" href={ytWatch(video.id)} data-yt={video.id} data-title={video.title}>
      <img src={video.thumbnail} alt="" loading={size === 'hero' ? 'eager' : 'lazy'} fetchpriority={size === 'hero' ? 'high' : 'auto'} width="480" height="360" />
      {badge && <span class="badge">{badge}</span>}
      <span class="play" aria-hidden="true"></span>
      <span class="sr-only">Play {video.title}</span>
    </a>
  ) : (
    <a class="thumb" href={ytWatch(video.id)} rel="noopener">
      <img src={video.thumbnail} alt="" loading="lazy" width="480" height="360" />
      {badge && <span class={`badge ${video.channel === 'isl' ? 'red' : ''}`}>{badge}</span>}
      <span class="play small" aria-hidden="true"></span>
    </a>
  )}
  <div class="meta">
    <h3 class="t"><a href={ytWatch(video.id)} rel="noopener">{video.title}</a></h3>
    <p class="muted">{timeAgo(video.publishedAt)}{video.views ? ` · ${video.views.toLocaleString('en-IN')} views` : ''}</p>
  </div>
</article>

<style>
  .vc { display: grid; gap: 10px; align-content: start; min-width: 0; }
  .thumb { position: relative; display: block; aspect-ratio: 16 / 9; overflow: hidden; background: var(--surface-2); border-radius: var(--r); }
  .thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .thumb:hover img { transform: scale(1.03); }
  .vc :global(iframe) { width: 100%; aspect-ratio: 16 / 9; border: 0; display: block; border-radius: var(--r); }
  .badge { position: absolute; top: 10px; left: 10px; }
  .play {
    position: absolute; inset: 0; margin: auto; width: 56px; height: 56px; border-radius: 50%;
    background: var(--brand); box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25); transition: transform 0.15s ease;
  }
  .thumb:hover .play { transform: scale(1.06); }
  .play::after { content: ''; position: absolute; left: 22px; top: 17px; border-left: 17px solid #fff; border-top: 11px solid transparent; border-bottom: 11px solid transparent; }
  .play.small { width: 38px; height: 38px; }
  .play.small::after { left: 15px; top: 11px; border-left-width: 12px; border-top-width: 8px; border-bottom-width: 8px; }
  .t { font: 600 16px/1.35 var(--body); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .t a { color: var(--text); text-decoration: none; }
  .t a:hover { color: var(--brand); text-decoration: underline; }
  .meta { display: grid; gap: 4px; }
  .meta .muted { font-size: 13.5px; }
  .hero .thumb { border-radius: var(--r); }
  .hero .t { -webkit-line-clamp: 3; }
  .hero .meta { gap: 6px; padding-top: 4px; }
  /* Shorts: 9:16 frame, the 4:3 thumbnail is cropped to its centre. */
  .vertical .thumb { aspect-ratio: 9 / 16; }
  .vertical .t { font-size: 14.5px; }
  .row { grid-template-columns: 128px minmax(0, 1fr); gap: 14px; align-items: center; }
  .row .thumb { border-radius: var(--r-sm); }
  .row .t { font-size: 14.5px; }
  .row .play.small { width: 28px; height: 28px; }
  .row .play.small::after { left: 11px; top: 8px; border-left-width: 9px; border-top-width: 6px; border-bottom-width: 6px; }
</style>
