# Copy to .env for local runs. Never commit real values.
# Neon pooled connection string (optional locally: without it, ingest writes JSON snapshots only)
DATABASE_URL=
# Optional: YouTube Data API v3 key for durations/views (RSS works without it)
YT_API_KEY=

# --- Write tab (fan and analyst posts). Set these as Cloudflare Pages variables/secrets; see docs/write-setup.md ---
# Cloudflare Turnstile (spam check). Leave empty locally to skip the check.
TURNSTILE_SECRET=
PUBLIC_TURNSTILE_SITE_KEY=
# Cloudflare Access (protects /armchair-gaffers/review and /api/write/review*). Set both in production so the JWT is verified.
CF_ACCESS_AUD=
CF_ACCESS_TEAM_DOMAIN=
# Second Access app (one-time PIN) that signs writers in: /armchair-gaffers/write/submit, /armchair-gaffers/write/mine, /api/write/submit, /api/write/mine*
CF_ACCESS_WRITER_AUD=
# Optional: random string mixed into the hashed IPs used for the submit rate limit
IP_SALT=
# R2 bucket binding POSTS_BUCKET is configured in the Pages project settings (Settings > Bindings), not here.
